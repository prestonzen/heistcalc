---
import Base from "./Base.astro";
import Ad from "../components/Ad.astro";
import { SITE } from "../config";

export interface Faq { q: string; a: string }
interface Props {
  title: string;
  description: string;
  h1?: string;
  published: string;
  updated?: string;
  crumbs?: { href: string; label: string }[];
  faq?: Faq[];
  tool?: { name: string; category?: string };
  sources?: { href: string; label: string }[];
}
const { title, description, h1 = title, published, updated = published, crumbs = [], faq = [], tool, sources = [] } = Astro.props;
const url = new URL(Astro.url.pathname, SITE.url).toString();
const fmt = (d: string) => new Date(d + "T00:00:00Z").toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" });

const schema: Record<string, unknown>[] = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: h1,
    description,
    datePublished: published,
    dateModified: updated,
    mainEntityOfPage: url,
    author: { "@type": "Organization", name: SITE.name, url: SITE.url },
    publisher: { "@type": "Organization", name: SITE.name, url: SITE.url },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [{ href: "/", label: "Home" }, ...crumbs, { href: Astro.url.pathname, label: h1 }].map((c, i) => ({
      "@type": "ListItem", position: i + 1, name: c.label, item: new URL(c.href, SITE.url).toString(),
    })),
  },
];
if (faq.length) {
  schema.push({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  });
}
if (tool) {
  schema.push({
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: tool.name,
    url,
    applicationCategory: tool.category ?? "GameApplication",
    operatingSystem: "Any",
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  });
}
---
<Base title={title} description={description} type="article" schema={schema}>
  <nav class="crumbs" aria-label="Breadcrumb">
    <a href="/">Home</a>
    {crumbs.map((c) => <><span>/</span><a href={c.href}>{c.label}</a></>)}
  </nav>
  <article class="article">
    <header class="article-head">
      <h1>{h1}</h1>
      <p class="lede">{description}</p>
      <p class="byline">By {SITE.author} · Updated <time datetime={updated}>{fmt(updated)}</time></p>
    </header>
    <Ad />
    <slot name="tool" />
    <div class="prose">
      <slot />
    </div>
    <Ad />
    {faq.length > 0 && (
      <section class="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Frequently asked questions</h2>
        {faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
      </section>
    )}
    {sources.length > 0 && (
      <section class="sources">
        <h2>Sources</h2>
        <ul>{sources.map((s) => <li><a href={s.href} rel="nofollow noopener" target="_blank">{s.label}</a></li>)}</ul>
      </section>
    )}
    <slot name="after" />
  </article>
</Base>
