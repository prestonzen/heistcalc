---
import Article from "../../layouts/Article.astro";

const cast = [
  { name: "Jason Duval", role: "Protagonist", region: "Leonida Keys", text: "Grew up around grifters, tried the Army to straighten out, and ended up in the Keys working for local drug runners. He wants an easy life, and meeting Lucia could make it better or much worse." },
  { name: "Lucia Caminos", role: "Protagonist", region: "Leonida", text: "Raised to fight, she landed in Leonida Penitentiary defending her family and got out on luck. She wants the good life her mother dreamed of since their Liberty City days, and plans to take it." },
  { name: "Boobie Ike", role: "Vice City kingpin", region: "Vice City", text: "A local legend who turned street money into real estate, a strip club and a recording studio. All smiles until business comes up. His big bet is Only Raw Records with Dre'Quan." },
  { name: "Dre'Quan Priest", role: "Music mogul", region: "Vice City", text: "More hustler than gangster. He dealt to get by, but music was always the goal. Now running Only Raw Records with Boobie and looking past booking acts at the strip club." },
  { name: "Real Dimez", role: "Rap duo", region: "Leonida", text: "Bae-Luxe and Roxy, high school friends who turned shaking down dealers into rap tracks and a big social following. Signed to Only Raw Records and chasing a second hit." },
  { name: "Raul Bautista", role: "Bank robber", region: "Leonida", text: "A seasoned, charming bank robber always recruiting talent for bigger scores, and reckless enough to raise the stakes on every job. The character most tied to GTA 6's heists." },
  { name: "Brian Heder", role: "Old-school smuggler", region: "Leonida Keys", text: "A veteran drug runner from the Keys' smuggling heyday, still moving product through his boat yard with his third wife, Lori. He lets Jason live rent-free in exchange for help with shakedowns." },
];

const faq = [
  { q: "Who are the main characters in GTA 6?", a: "Jason Duval and Lucia Caminos, a criminal couple whose easy score goes wrong and pulls them into a conspiracy across Leonida." },
  { q: "Who is Raul Bautista in GTA 6?", a: "A seasoned bank robber who recruits talent for high-risk scores. Rockstar describes him as charming, cunning and increasingly reckless, so he's likely central to GTA 6's heists." },
  { q: "Is Lucia from Liberty City?", a: "Rockstar says Lucia and her mother have dreamed of a better life since their days in Liberty City, so she has roots there before coming to Leonida." },
  { q: "Who are Real Dimez?", a: "A rap duo, Bae-Luxe and Roxy, signed to Only Raw Records, the label run by Dre'Quan Priest and backed by Boobie Ike." },
];
---
<Article
  image={{ src: "/img/gta-6/gta6-jason-fish-dock.webp", alt: "Jason in a tank top and backwards cap holding up a freshly caught rainbow-colored fish on a waterside dock" }}
  title="GTA 6 Characters: Jason, Lucia & Every Confirmed Name"
  h1="GTA 6 Characters: Who's Who in Leonida"
  description="Every confirmed GTA 6 character: Jason Duval, Lucia Caminos, Boobie Ike, Dre'Quan Priest, Real Dimez, Raul Bautista and Brian Heder, and how they connect."
  published="2026-11-18"
  crumbs={[{ href: "/gta-6/", label: "GTA 6" }]}
  faq={faq}
  sources={[{ href: "https://www.rockstargames.com/VI/only-in-leonida", label: "Rockstar Games: Only in Leonida (official character profiles)" }]}
>
  <p>GTA 6 follows <strong>Jason Duval and Lucia Caminos</strong>, a couple who, in Rockstar's words, find themselves on the darkest side of the sunniest place in America after an easy score goes wrong. Rockstar's official site profiles five more characters. Here's who they are and how they connect. These are our summaries of Rockstar's profiles, with no story spoilers beyond what Rockstar has published.</p>

  <div class="table-scroll"><table>
    <thead><tr><th>Character</th><th>Role</th><th>Base</th></tr></thead>
    <tbody>{cast.map((c) => <tr><td><a href={`#${c.name.toLowerCase().replace(/[^a-z]+/g, "-")}`}>{c.name}</a></td><td>{c.role}</td><td>{c.region}</td></tr>)}</tbody>
  </table></div>

  {cast.map((c) => (
    <>
      <h2 id={c.name.toLowerCase().replace(/[^a-z]+/g, "-")}>{c.name}</h2>
      <p>{c.text}</p>
      {c.name === "Lucia Caminos" && (
        <figure style="margin:20px 0">
          <img src="/img/gta-6/gta6-lucia-derby-organizer.webp" alt="Lucia in a yellow patterned shirt and denim shorts standing outside the Team 360 Wing-It demolition derby tent" width="1280" height="720" loading="lazy" decoding="async" style="border-radius:8px;width:100%;height:auto" />
          <figcaption><small>Lucia outside the Team 360 'Wing-It' tent, where you sign up for Demolition Derby races.</small></figcaption>
        </figure>
      )}
    </>
  ))}

  <h2>How they connect</h2>
  <ul>
    <li><strong>Only Raw Records:</strong> Boobie Ike backs the label, Dre'Quan Priest runs it, and Real Dimez are its big signing.</li>
    <li><strong>The Keys:</strong> Jason lives rent-free at one of Brian Heder's properties and does shakedowns for him.</li>
    <li><strong>Heists:</strong> Raul Bautista is the professional bank robber looking for a crew. Read what's confirmed about <a href="/gta-6/heists/">heists in GTA 6</a>.</li>
  </ul>

  <h2>Explore their world</h2>
  <p>See where each of them operates on the <a href="/gta-6/map/">interactive Leonida map</a>, from the Keys to Vice City.</p>
</Article>
