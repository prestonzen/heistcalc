const mods: [string, string, string][] = [
  ["Engine Upgrade Stage 1", "$900", "+0.3 Speed and Acceleration (guides)"],
  ["Engine Upgrade Stage 2", "$1,800", "Took our Ganado from 5.2 to 5.4 Speed (seen on stream)"],
  ["Transmission Level 1 / 2", "$600 / $1,500", "Level 2 raised our Acceleration to 6.0"],
  ["Air filters", "$750–800", "+0.1 each. We saw $800 for the Pill Shaped filter"],
  ["Lowered suspension", "$750", "+0.1 (guides)"],
  ["Nitrous", "About $5,000", "A short speed burst (guides)"],
