---
import Article from "../../layouts/Article.astro";
import Share from "../../components/Share.astro";
import { acts, SRC_LABEL } from "../../data/money";

// Calculator rows live in src/data/money.ts (also served as /data/gta6-money.json).
const fmt0 = (n: number) => (n >= 1000 ? `$${(n / 1000).toFixed(n % 1000 && n < 10000 ? 1 : 0)}k` : `$${n}`);

const once = [
  ["End of Chapter 3", "$120,000 (automatic)"],
  ["Pilot Pete's jobs (Chapter 4, Jason)", "$12,000 (✓ our stream: +$12,000 for the first delivery) + $20,000 + $20,000 (reported)"],
  ["Help Kirk Find Mr. Mangrove", "$5,000 if you shoot Mr. Mangrove (seen on our stream; some guides say $10,000)"],
  ["Shirley's rum stash", "About $1,300"],
  ["Crab research outpost safe (code 0072)", "About $1,000 plus a unique SMG"],
];
const faq = [
  { q: "What's the best money per hour in GTA 6?", a: "For almost the whole game, our Demolition Derby cheese with your partner: up to $6,300 a win for $930 in rentals, about 2 minutes a race, roughly $161,000 an hour, with no police. Only the large bank vaults at the end of Chapter 4 may beat it, if the $65,000–205,000 per vault that guides report holds up." },
  { q: "What's the fastest way to make money early in GTA 6?", a: "In Chapter 1, don't grind, because your cash is wiped at Tourist Trap. In Chapter 2, sell untracked cars to Moses ($1,000–2,000 each, a few minutes per car). Figure-8 Demolition Derbies are the best: bring Lucia and a win pays up to $6,300 for $930 in rentals ($3,150 and $465 solo), and a race averages about 2 minutes with the ramp method, roughly $161,000 an hour with your partner. You win by being the last car running, not by speed." },
  { q: "How much cash can you carry in GTA 6?", a: "$20,000 in pocket cash per character. Getting wasted or busted can cost you what you carry, so bank it at an ATM before risky jobs." },
  { q: "Can you sell fish in GTA 6?", a: "No. Fishing is catch-and-release, so it doesn't pay. Hunting does: Bret buys animals in good condition." },
  { q: "Is there a money cheat in GTA 6?", a: "Yes, +$250,000, but it only unlocks after the story, and using cheats blocks saving, so the money doesn't stay. See our cheat codes page." },
];
---
<Article
  title="GTA 6 Money Calculator and Planner: Best Ways to Make Money by Chapter"
  h1="GTA 6 Money Guide and Money Per Hour Calculator"
  description="Plan your GTA 6 money by chapter: pick a goal and the planner counts the runs. Money per hour for bank vaults, Randy's supercars, jewelry stores, Moses car sales, Demolition Derby and more, with every number labelled by how well it's sourced."
  published="2026-11-20"
  updated="2026-11-25"
  crumbs={[{ href: "/gta-6/", label: "GTA 6" }]}
  faq={faq}
  tool={{ name: "GTA 6 Money Per Hour Calculator" }}
  sources={[
    { href: "https://www.powerpyx.com/gta-6-money-guide-how-to-get-money-fast/", label: "PowerPyx: money guide" },
    { href: "https://www.powerpyx.com/gta-6-all-bank-jobs-locations-bank-vaults/", label: "PowerPyx: all 22 bank jobs" },
    { href: "https://www.gtabase.com/gta-6/articles/how-to-make-money-fast-in-gta-6", label: "GTABase: how to make money fast" },
    { href: "https://outputlag.com/guides/gta-6-make-money-fast/", label: "Output Lag: make money fast" },
    { href: "https://outputlag.com/guides/gta-6-how-to-rob-stores-heists/", label: "Output Lag: robbing stores" },
    { href: "https://timesaver.gg/tools/gta-6/money/bank-vaults", label: "Timesaver: bank vault payouts" },
    { href: "https://egamers.io/how-to-rob-banks-in-gta-6/", label: "eGamers: robbing banks" },
    { href: "https://www.gamerfuzion.com/gta-6-money-guide-how-to-make-money-fast", label: "GamerFuzion: money guide" },
    { href: "https://www.gtabase.com/gta-6/strangers/petes-deliveries-southpoint-airfield", label: "GTABase: Pete's Deliveries" },
  ]}
>
  <section slot="tool" class="calc" id="mph-calc">
    <h2>Money per hour calculator</h2>
    <a href="/gta-6/demolition-derby/" class="callout" style="display:block;text-decoration:none;border-color:var(--money);margin:12px 0"><strong>🔥 The best money in GTA 6 for almost the whole game: our Demolition Derby cheese.</strong> Bring Lucia and a win pays up to $6,300 ($5,370 after rentals). Park on the figure-8 ramp, about 2 minutes a race: roughly $161,000 an hour. <u>Read the guide →</u></a>
    <a href="/gta-6/smash-and-grab/" class="callout" style="display:block;text-decoration:none;margin:12px 0"><strong>New: all 16 Smash and Grab locations.</strong> Every jewelry store and pawn shop with its security level and take value, read off the in-game map. <u>See the list →</u></a>
    <a href="/gta-6/atm-robbery/" class="callout" style="display:block;text-decoration:none;margin:12px 0"><strong>New: ATM robbery guide.</strong> Rip ATMs out of the wall with a winch, break the cash cassettes, and what they pay. <u>Read the guide →</u></a>
    <p><small>Payouts are the middle of what guides report. Most run times are our estimates, because nobody has published timed runs yet. Change any number to match your own runs; the ranking updates when you click out of the box.</small></p>
    <fieldset id="chaps" style="border:1px solid var(--line);border-radius:10px;padding:10px 14px">
      <legend><small>1. Where are you in the story?</small></legend>
      <div style="display:flex;flex-wrap:wrap;gap:16px">
        {[1, 2, 3, 4, 5].map((n) => <label class="check"><input type="radio" name="hc-ch" value={n} checked={n === 2} /> {n === 5 ? "Ch 5 / story done" : `Ch ${n}`} <small class="muted">{acts.some((a) => a.ch === n) ? `+${acts.filter((a) => a.ch === n).length} jobs` : "nothing new"}</small></label>)}
      </div>
    </fieldset>

    <div class="planner" id="planner">
      <h3 style="margin:0 0 8px">Money goal planner</h3>
      <p style="margin:0 0 8px"><small>2. Pick what you're saving for, 3. enter what you have. The planner picks the best job open to you and counts the runs.</small></p>
      <div class="targets">
        {[
          [15000, "Fill Chapter 2 checking", "$15,000 checking cap early in Chapter 2 (✓ our stream)"],
          [100000, "BuckMe Gold", "$100,000 in Family Savings: 20% off garages (1 source)"],
          [160000, "All 8 garages", "8 garages with BuckMe Gold's 20% off; $200,000 without (reported)"],
          [500000, "BuckMe Black", "$500,000 in Family Savings (1 source)"],
          [1000000, "Rich as Buck", "$1,000,000 in Family Savings (1 source)"],
          [2000000, "Final savings tier", "$2,000,000 in Family Savings (1 source)"],
        ].map(([v, l, t]) => <button type="button" class="btn-ghost tgt" data-target={v} title={t}><strong>${Number(v) >= 1e6 ? `${Number(v) / 1e6}M` : `${Number(v) / 1000}k`}</strong> {l}</button>)}
      </div>
      <div class="plan-inputs">
        <label>Target ($)<input id="pl-target" type="number" min="0" step="1000" value="15000" inputmode="numeric" /></label>
        <label>Cash + checking now ($)<input id="pl-have" type="number" min="0" step="500" value="0" inputmode="numeric" /></label>
      </div>
      <div id="pl-out" aria-live="polite"></div>
      <div class="bar" aria-hidden="true"><span id="pl-bar"></span></div>
      <p style="margin:6px 0 0"><small class="muted">Saved on this device. Runs use the reported per-run range (best case to worst case); time uses the minutes per run you set below.</small></p>
    </div>
    <p style="margin-top:12px"><small><strong>Potential</strong> is what you'd make if every run worked. <strong>Expected</strong> is the realistic average: payout × success rate, minus what a failed run costs you (for the Derby, the retry fee: $700 with your partner). The ranking uses Expected. Set the success rate to your own. The figure-8 Derby ramp method is set to 100%: you can't die in a derby, a race averages about 2 minutes, and a straggler only costs time. Robberies won't go perfectly every time, so small banks start at 65% (we lost one bank haul of 3 to the cops) and vaults at 70%.</small></p>
    <p style="margin-top:4px"><small><strong>Difficulty:</strong> Easy = little risk, Medium = police chase or a careful delivery, Hard = high wanted level or you only get paid if you win.</small></p>
    <p style="margin-top:4px"><small>Tick <strong>Loop</strong> on the activities you chain together (for example, rob a store on the way to Moses with a stolen car) to see what the whole rotation earns per hour.</small></p>
    <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:4px">
      <button type="button" class="btn-ghost" style="padding:6px 12px;font-size:.85rem" data-preset="moses,store">Chapter 2: cars + stick-ups</button>
      <button type="button" class="btn-ghost" style="padding:6px 12px;font-size:.85rem" data-preset="derby8duo,moses">Chapter 2: figure-8 Derby with Lucia + a car to Moses</button>
      <button type="button" class="btn-ghost" style="padding:6px 12px;font-size:.85rem" data-preset="randy,jewel,spray">Chapter 3: supercars + jewelry</button>
      <button type="button" class="btn-ghost" style="padding:6px 12px;font-size:.85rem" data-preset="">Clear loop</button>
    </div>
    <div id="mph-rows" class="acts">
      {acts.map((a) => (
        <article class="act" data-id={a.id} data-ch={a.ch} data-diff={a.diff} data-lo={a.lo} data-hi={a.hi} data-pays={a.pays}>
          <div class="act-head">
            <span class="rank"></span>
            <div class="act-title">
              <strong class="act-name">{a.name}</strong>
              <span class="act-tags"><span class={`diff d${a.diff}`}>{["", "Easy", "Medium", "Hard"][a.diff]}</span> <span class="act-ch">Ch {a.ch}+</span> <span class={`src src-${a.src === "2+" ? "two" : a.src}`}>{SRC_LABEL[a.src]}</span>{a.ok == null && <span class="act-ch">untested</span>}</span>
            </div>
            <label class="act-loop"><input type="checkbox" class="loop" aria-label={`Add ${a.name} to my loop`} /> Loop</label>
          </div>
          <div class="act-body">
            <div class="act-inputs">
              <label>Payout ($)<input class="pay" type="number" min="0" step="100" value={a.pay} inputmode="numeric" /></label>
              <label>Success %<input class="ok" type="number" min="0" max="100" step="1" value={a.ok ?? 75} inputmode="numeric" /></label>
              <label>Lost on a fail ($)<input class="fail" type="number" min="0" step="50" value={a.fail ?? 0} inputmode="numeric" /></label>
              <label>Time per run<span class="act-time"><input class="mm" type="number" min="0" step="1" value={Math.floor(a.min)} inputmode="numeric" aria-label={`${a.name} minutes`} /><b>:</b><input class="ss" type="number" min="0" max="59" step="1" value={String(Math.round((a.min % 1) * 60)).padStart(2, "0")} inputmode="numeric" aria-label={`${a.name} seconds`} /></span></label>
            </div>
            <div class="act-out">
              <div><small>Expected / hr</small><strong class="rate">-</strong></div>
              <div><small>Potential / hr</small><span class="pot">-</span></div>
            </div>
          </div>
          <details class="act-more"><summary>Details</summary><p><small><strong>Reported:</strong> {a.range}. <strong>Time:</strong> {a.time}. {a.note}</small></p></details>
        </article>
      ))}
    </div>
    <p id="mph-best" style="margin-top:12px"></p>
    <p id="mph-loop" style="margin-top:4px"></p>
    <Share target="mph-calc" />
  </section>

  <div class="callout"><p><strong>These are reported payouts, not HeistCalc-verified numbers</strong>, except where we say we saw it on stream. Guides are only days old and often disagree, so this page shows the range and gets updated as numbers settle.</p></div>

  <h2>GTA 6 money at a glance</h2>
  <div class="table-scroll"><table>
    <tbody>
      <tr><th scope="row">Best money per hour</th><td>Figure-8 Demolition Derby with your partner: up to $6,300 a win, about $161,000 an hour (✓ our stream)</td></tr>
      <tr><th scope="row">Biggest single score</th><td>Large bank vaults, $65,000–205,000 each, from the end of Chapter 4 (2+ sources)</td></tr>
      <tr><th scope="row">First real income</th><td>Chapter 2: Derby wins and untracked cars to Moses</td></tr>
      <tr><th scope="row">Banks</th><td>22: 14 small, 8 large with a vault. <a href="/gta-6/banks/">All 22 banks and what they hold</a></td></tr>
      <tr><th scope="row">Pocket cash limit</th><td>$20,000 per character</td></tr>
      <tr><th scope="row">Wasted or busted</th><td>You lose the cash you carry; checking takes a smaller hit (reported)</td></tr>
      <tr><th scope="row">Story payout</th><td>$120,000 at the end of Chapter 3 (1 source)</td></tr>
      <tr><th scope="row">Money cheat</th><td>+$250,000, after the story only, and cheats block saving</td></tr>
    </tbody>
  </table></div>
  <p><small>How sure are we? Each job in the calculator carries a label: <span class="src src-stream">✓ our stream</span> we saw it ourselves, <span class="src src-two">2+ sources</span> two or more independent guides agree, <span class="src src-1">1 source</span> only one guide so far, <span class="src src-disputed">sources disagree</span> the range shows the spread. The whole dataset is open: <a href="/data/gta6-money.json">gta6-money.json</a>.</small></p>

  <h2>What opens in each chapter</h2>
  <div class="chapters">
    {[1, 2, 3, 4, 5].map((n) => {
      const opens = acts.filter((a) => a.ch === n).sort((x, y) => y.hi - x.hi);
      const tip = ["", "Cash is wiped at Tourist Trap. Play the story.", "Grind figure-8 Derbies with your partner.", "The story pays $120,000 at the end of the chapter.", "Vaults open with an optional mission at the very end.", "Nothing new opens. Keep running vaults."][n];
      return (
        <div class="chap">
          <div class="chap-h">{n === 5 ? "Ch 5 / after" : `Chapter ${n}`}</div>
          {opens.length ? <ul>{opens.map((a) => <li><span>{a.name.replace(/ \(.*\)$/, "")}</span><b>{a.lo === a.hi ? fmt0(a.hi) : `to ${fmt0(a.hi)}`}</b></li>)}</ul> : <p><small>No new job opens.</small></p>}
          <p class="chap-tip"><small>{tip}</small></p>
        </div>
      );
    })}
  </div>

  <h2>Money methods with no dollar figure yet</h2>
  <ul>
    <li><strong>Gang operations.</strong> Hideouts marked on the map. They mostly pay in narcotics you sell to a fence. No guide has a dollar range yet.</li>
    <li><strong>Towable ATMs and security trucks.</strong> Unlocked through Yasmani's jobs. Our <a href="/gta-6/atm-robbery/">ATM guide</a> has what we've seen so far.</li>
    <li><strong>Later street races.</strong> Only single prizes are known: $3,000 for Yago's first race.</li>
  </ul>
  <p>Got a number from your own game? These are the ones we'll test on stream next.</p>

  <h2>Guides for each money job</h2>
  <div class="guides">
    <a href="/gta-6/demolition-derby/"><b>Up to $6,300</b>Demolition Derby<small>Chapter 2 · ✓ our stream</small></a>
    <a href="/gta-6/banks/"><b>$5k to $205k</b>All 22 banks<small>Chapter 3 and 4</small></a>
    <a href="/gta-6/smash-and-grab/"><b>Up to $25k</b>Jewelry stores and pawn shops<small>Chapter 2 · ✓ our stream</small></a>
    <a href="/gta-6/atm-robbery/"><b>Up to $7,200</b>ATM rip-outs<small>Chapter 3</small></a>
    <a href="/gta-6/safe-codes/"><b>Safe codes</b>Every known code<small>Robberies and stashes</small></a>
    <a href="/gta-6/buckme/"><b>BuckMe</b>Checking, savings tiers<small>What you keep</small></a>
    <a href="/gta-6/garages/"><b>Garages</b>All 8 to buy, $4k to $40k<small>What to spend it on</small></a>
  </div>

  <h2>Best money by chapter</h2>
  <ul>
    <li><strong>Chapter 1:</strong> don't grind. Your cash, checking and car are wiped at Tourist Trap. Move up to $5,000 into Family Savings (see the <a href="/gta-6/buckme/">BuckMe calculator</a>) and spend the rest.</li>
    <li><strong>Chapter 2:</strong> figure-8 Demolition Derbies with your partner (up to $6,300 a win, about $161,000 an hour at a 2-minute average; $3,150 solo) and untracked cars to Moses. Jewelry stores and pawn shops also open for smash and grab in Chapter 2 (checked on our stream); the bigger ones hold $14,000–25,000, and grabbing the safe cash beats smashing every case before the cops arrive. Hunting for Bret is a quieter option for Jason. The oval derby barely beats its rental fee.</li>
    <li><strong>Chapter 3:</strong> the Derby with your partner is still the best money (about $161,000 an hour). After that, Randy's Wish List supercars, then banks and Payday Loans, with jewelry stores still worth a hit. Pay 'n' Spray takes cars Moses won't, and vans pay well there: a stolen U.S. National Mail Service van sold for $2,750 and a Vapid Speedo van for $1,800 on our stream.</li>
    <li><strong>Chapter 4 and after the story:</strong> large bank vaults beat everything else by a wide margin.</li>
  </ul>

  <h2>A Chapter 2 money rotation</h2>
  <p>On its own, Moses can only buy a car every couple of minutes, so the trick is filling that cooldown with something on the way:</p>
  <ol>
    <li><strong>Steal an untracked car far from Port Gellhorn.</strong> Moses won't buy cars stolen near his garage, and anything with a tracker is a Pay 'n' Spray job for Chapter 3.</li>
    <li><strong>Hit a store on the drive over</strong> if one is on your route. It's only a few hundred dollars, so don't detour for it, and don't wreck the car escaping: damage cuts Moses's price.</li>
    <li><strong>Sell to Moses</strong> for about $1,000–2,000, then go find the next car while his cooldown runs.</li>
    <li><strong>Selling the cars in your garage:</strong> Moses will buy them, but not from the normal menu. Drive in with any car, pick <strong>Services</strong> (not "Sell current car"), then choose <strong>Sell all</strong>. That sells your garage cars in one go (checked on our stream).</li>
    <li><strong>Better yet, grind figure-8 Demolition Derbies.</strong> Bring Lucia: up to $6,300 for 1st minus $930 in rentals, about 2 minutes a race: several times what car sales make per hour. You win by surviving, not by speed. Grab a car to sell to Moses on your way out.</li>
  </ol>
  <h3 id="moses-delivery-trick">Trick: deliver a car to Moses without driving it there</h3>
  <p>Found on our stream with Moses's '74 Declasse Vamos job (2.4 miles from Grayson to Watkins Auto Parts). Your partner can bring the car over almost instantly:</p>
  <ol>
    <li>Put your partner in the car you're delivering, driving it.</li>
    <li>Get out and order a RydeMe to Moses at Watkins Auto Parts, then skip the ride.</li>
    <li>When you arrive, open the partner menu and pick <strong>Drive here</strong>. Your partner pulls up with the car a few seconds later, so you can drive it into Moses's garage.</li>
  </ol>
  <p>You skip the long drive and the risk of damaging the car on the way, and damage cuts Moses's price. The Vamos sold for $4,200.</p>
  <h3 id="stash-cars-trick">Trick: stash stolen cars to sell later</h3>
  <p>When Pay 'n' Spray is full or the garage nearby has no room, don't leave a good car on the street. Send it home with your partner instead:</p>
  <ol>
    <li>Steal the car and put your partner in the driver's seat.</li>
    <li>Have your partner take it home, into your protected parking or garage.</li>
    <li>Keep stealing. Once there's room again, sell the stashed cars, or sell your whole garage to Moses with <strong>Services</strong> then <strong>Sell all</strong>.</li>
  </ol>
  <p>You keep stealing while your partner does the driving, and parked cars don't get damaged. We found this while playing.</p>
  <p>Bank your cash at an ATM every few runs, because you can only carry $20,000 and dying or getting busted costs what's in your pocket. Use the Loop buttons in the calculator with your own times to see which rotation actually pays best for you.</p>

  <h2>How to win Demolition Derby</h2>
  <p>We tested it on stream. The Derby isn't a race: lap times and top speed don't matter. You win by being the last car still running, and the AI makes that easy:</p>
  <ul>
    <li><strong>Rent the '72 Tulip.</strong> It's the car that worked for us.</li>
    <li><strong>Camp.</strong> Hang back and let the AI cars pile into each other. They don't come hunting for you.</li>
    <li><strong>Ram in reverse.</strong> Back into the damaged cars to finish them off. Hitting with your rear keeps your engine alive, and the AI doesn't react to it.</li>
    <li><strong>Retry until you win.</strong> 2nd place still pays $1,500, and a retry is $315, half the $615 rental, so keep retrying until you finish 1st.</li>
    <li><strong>Pick the figure-8 track.</strong> 1st place pays $3,150, the maximum the game lists, about double the oval's $1,900. Full guide: <a href="/gta-6/demolition-derby/">how to win the Demolition Derby</a>.</li>
    <li><strong>The numbers we got:</strong> $3,150 prize minus the $465 cheapest rental is $2,685 profit, and a race averages about 2 minutes. At a realistic 2-minute average that's about $80,000 an hour solo. <strong>Bring Lucia and it doubles:</strong> up to $6,300 a win for $930 in rentals, about $161,000 an hour, the best money in the game until the bank vaults at the end of Chapter 4. 2nd place still pays $1,500 and a retry costs only $315 (half the rental). So coming 2nd isn't a loss: 2nd place, then a retry you win, nets about $3,700 for two rounds.</li>
  </ul>

  <h2>One-time payouts worth knowing</h2>
  <div class="table-scroll"><table>
    <thead><tr><th>Source</th><th>Payout</th></tr></thead>
    <tbody>{once.map(([s, p]) => <tr><td><strong>{s}</strong></td><td>{p}</td></tr>)}</tbody>
  </table></div>

  <h2>Cash rules that cost players money</h2>
  <ul>
    <li><strong>Chapter 1 cash doesn't carry over.</strong> Spend it or save it in Family Savings before Tourist Trap.</li>
    <li><strong>You can carry $20,000.</strong> Bank the rest at an ATM. Getting wasted or busted can cost you what's in your pocket.</li>
    <li><strong>Checking has a limit.</strong> It starts at $15,000, and when it's full new payments wait until there's room. In Chapter 2, once heists are unlocked and Family Savings is filled, checking and Family Savings both go up to $100,000 (checked on our stream). See the <a href="/gta-6/buckme/">BuckMe guide</a>.</li>
    <li><strong>Time to cash matters.</strong> Safe cash can go straight into an ATM, but jewelry and marked bills still need a trip to a fence. Taxi fast travel doesn't work after a crime in the area, so you drive that leg with the cops around. On a robbery, the safe-and-ATM route turns into spendable money fastest.</li>
    <li><strong>Yasmani's security van tips cost $10,000 each.</strong> They're a cost, not income, and they unlock after you rob 2 Payday Loans stores.</li>
    <li><strong>Fishing doesn't pay.</strong> It's catch-and-release only.</li>
    <li><strong>Family Savings is one-way.</strong> Money there is safe from death and arrest, but you can't take it back out. It only unlocks tiers and perks.</li>
    <li><strong>Big purchases come out of BuckMe.</strong> Guides report vendors take pocket cash only up to $999; anything dearer is charged to your account.</li>
    <li><strong>Robbery safes need codes.</strong> All known codes are on our <a href="/gta-6/safe-codes/">safe codes page</a>.</li>
  </ul>
  <p>More: the <a href="/gta-6/fastest-cars/">fastest cars and where to find them</a>, <a href="/gta-6/collectibles/">collectibles</a> (duplicate cards sell at pawn shops) and <a href="/gta-6/heists/">GTA 6 heists</a>.</p>

  <script is:inline>
    (() => {
      const rows = [...document.querySelectorAll("#mph-rows .act")];
      const boxes = [...document.querySelectorAll("#chaps input")];
      const fmt = (n) => "$" + Math.round(n).toLocaleString("en-US");
      const KEY = "hc-gta6-mph";
      const name = (r) => r.querySelector(".act-name").textContent;
      const tIn = document.getElementById("pl-target"), hIn = document.getElementById("pl-have");
      try {
        const saved = JSON.parse(localStorage.getItem(KEY) || "null");
        if (saved) {
          const c = Array.isArray(saved.ch) ? Math.max(1, ...saved.ch) : Number(saved.ch) || 2; // older saves stored a list of ticked chapters
          boxes.forEach((b) => (b.checked = Number(b.value) === c));
          rows.forEach((r) => (r.querySelector(".loop").checked = (saved.loop || []).includes(r.dataset.id)));
          if (saved.target != null) tIn.value = saved.target;
          if (saved.have != null) hIn.value = saved.have;
        }
      } catch {}
      { const q = new URLSearchParams(location.search).get("target"); if (q && Number(q) > 0) tIn.value = Math.round(Number(q)); } // links from other pages, e.g. the garage calculator
      const dur = (m) => (m < 60 ? `${Math.max(1, Math.round(m))} min` : `${(m / 60).toFixed(m < 600 ? 1 : 0)} h`);
      function plan(list, chap) {
        const target = Math.max(0, Number(tIn.value) || 0), have = Math.max(0, Number(hIn.value) || 0), rem = target - have;
        const out = document.getElementById("pl-out");
        document.getElementById("pl-bar").style.width = (target ? Math.min(100, (have / target) * 100) : 0) + "%";
        document.querySelectorAll(".tgt").forEach((b) => b.classList.toggle("on", Number(b.dataset.target) === target));
        if (chap === 1) { out.innerHTML = `<p><strong>Chapter 1: don't grind.</strong> Your cash, checking and car are wiped at Tourist Trap. Put up to $5,000 in Family Savings (see the <a href="/gta-6/buckme/">BuckMe guide</a>), spend the rest and play the story.</p>`; return; }
        if (rem <= 0) { out.innerHTML = `<p><strong>You're there.</strong> ${fmt(have)} covers your ${fmt(target)} target.</p>`; return; }
        const open = list.filter((x) => x.open && x.rate > 0);
        if (!open.length) { out.innerHTML = "<p>No job open yet.</p>"; return; }
        // Every run counts its success rate: a failed attempt pays nothing and costs the "lost on a fail" amount,
        // so a 65% bank needs more attempts than a 100% Derby. Range = reported low to high payout per success.
        const per = (x, v) => v * x.ok - x.lose * (1 - x.ok);
        const job = (x, need) => {
          const lo = Number(x.r.dataset.lo), hi = Number(x.r.dataset.hi);
          const eHi = per(x, hi), eLo = per(x, lo);
          const best = Math.ceil(need / Math.max(1, eHi)), worst = eLo > 0 ? Math.ceil(need / eLo) : Infinity;
          const runs = best === worst ? `${best}` : worst === Infinity ? `${best}+` : `${best} to ${worst}`;
          const t = best === worst ? dur(best * x.min) : worst === Infinity ? `${dur(best * x.min)}+` : `${dur(best * x.min)} to ${dur(worst * x.min)}`;
          return { runs, t, mine: Math.ceil(need / Math.max(1, x.pay)), lo, hi };
        };
        const b = open[0], j = job(b, rem), pays = b.r.dataset.pays;
        const catches = [];
        if (b.ok < 1) catches.push(`Counts a ${Math.round(b.ok * 100)}% success rate: ${Math.round((1 - b.ok) * 100)} in 100 attempts pay nothing${b.lose ? ` and cost ${fmt(b.lose)}` : ""}. Change it in the job's row below.`);
        if (/marked/.test(pays)) catches.push("It pays in marked bills: you need the Dye Pack Jammer (Chapter 3, Credit Check) and a fence before it's spendable.");
        if (/jewel/.test(pays)) catches.push("Jewelry has to be sold to a fence.");
        if (rem > 20000) catches.push(`You can only carry $20,000, so bank at an ATM ${b.pay >= 20000 ? "after every run" : `every ${Math.max(1, Math.floor(20000 / b.pay))} runs`}. Getting wasted or busted costs what's in your pocket.`);
        if (chap === 2 && target > 15000) catches.push("Checking caps at $15,000 early in Chapter 2; it goes up to $100,000 once heists unlock and Family Savings is full.");
        const alt = open.slice(1, 3).map((x) => { const k = job(x, rem); return `<li>${name(x.r)}: ${k.runs} runs, ${k.t}</li>`; }).join("");
        // Time to every savings goal from where you are, grinding the best job open to you.
        const goals = [...new Set([15000, 100000, 500000, 1000000, 2000000, target])].sort((x, y) => x - y).filter((g) => g > have);
        const hm = (x) => { const m = Math.round(x), h = Math.floor(m / 60), mm = m % 60; return h ? `${h} h ${String(mm).padStart(2, "0")} min` : `${mm} min`; };
        const timer = goals.map((g) => {
          const need = g - have, m = (need / Math.max(1, b.rate)) * 60;
          return `<tr${g === target ? ' class="on"' : ""}><td>${fmt(g)}</td><td><strong>${hm(m)}</strong></td><td>${Math.ceil(need / Math.max(1, b.pay))}</td><td>${m < 18 ? "under 0.1" : (m / 180).toFixed(m < 180 ? 1 : 0)}</td></tr>`;
        }).join("");
        out.innerHTML = `<p style="margin:0">${fmt(rem)} to go. Best job open to you:</p>
          <p class="plan-big"><strong>${j.runs} ${/^Demolition|races/.test(name(b.r)) ? "wins" : "runs"}</strong> of ${name(b.r)}</p>
          <p style="margin:0"><small>${j.lo === j.hi ? fmt(j.lo) : `${fmt(j.lo)} to ${fmt(j.hi)}`} per success · about ${j.t} at ${dur(b.min)} a run. With your numbers below (${fmt(b.pay)} expected a run): ${j.mine} runs, ${hm(j.mine * b.min)}.</small></p>
          ${catches.length ? `<ul class="plan-catch">${catches.map((c) => `<li><small>${c}</small></li>`).join("")}</ul>` : `<p><small>No catches on this plan. Deposit at an ATM after every big job.</small></p>`}
          <p style="margin:10px 0 4px"><strong>⏱ Time to each goal</strong> <small class="muted">grinding ${name(b.r)} at ${fmt(b.rate)}/hour</small></p>
          <div class="table-scroll"><table class="timer"><thead><tr><th>Goal</th><th>Grind time</th><th>Runs</th><th>3-hour sessions</th></tr></thead><tbody>${timer}</tbody></table></div>
          ${alt ? `<p style="margin:8px 0 0"><small>Next best for this target:</small></p><ul class="plan-alt"><small>${alt}</small></ul>` : ""}`;
      }
      // resort=false while typing, so rows don't jump under your cursor; the table re-ranks when you leave the box or press Enter.
      function calc(resort = true) {
        const chap = Number((boxes.find((b) => b.checked) || { value: 2 }).value);
        const unlocked = new Set([1, 2, 3, 4, 5].filter((n) => n <= chap));
        const list = rows.map((r) => {
          const win = Math.max(0, Number(r.querySelector(".pay").value) || 0);
          const ok = Math.min(100, Math.max(0, Number(r.querySelector(".ok").value) || 0)) / 100;
          const lose = Math.max(0, Number(r.querySelector(".fail").value) || 0);
          const pay = win * ok - lose * (1 - ok); // expected money per attempt
          const secs = Math.max(10, (Number(r.querySelector(".mm").value) || 0) * 60 + (Number(r.querySelector(".ss").value) || 0));
          const min = secs / 60;
          const rate = (pay / secs) * 3600;
          r.querySelector(".rate").textContent = fmt(rate);
          r.querySelector(".pot").textContent = fmt((win / secs) * 3600);
          const open = unlocked.has(Number(r.dataset.ch));
          r.style.opacity = open ? "1" : "0.4";
          return { r, rate, open, pay, min, ok, lose, loop: r.querySelector(".loop").checked };
        });
        list.sort((a, b) => (b.open - a.open) || (b.rate - a.rate));
        if (resort) {
          const body = document.getElementById("mph-rows");
          list.forEach((x, i) => { body.appendChild(x.r); x.r.querySelector(".rank").textContent = x.open ? String(i + 1) : "🔒"; });
        }
        const best = list.find((x) => x.open);
        document.getElementById("mph-best").textContent = best
          ? `Best single activity for you: ${name(best.r)} at about ${fmt(best.rate)} per hour expected. Greyed rows open in a later chapter.`
          : "Pick your chapter.";
        const loop = list.filter((x) => x.loop);
        const pay = loop.reduce((s, x) => s + x.pay, 0), min = loop.reduce((s, x) => s + x.min, 0);
        const mmss = (m) => { const t = Math.round(m * 60); return `${Math.floor(t / 60)}:${String(t % 60).padStart(2, "0")}`; };
        const locked = loop.filter((x) => !x.open).map((x) => name(x.r));
        document.getElementById("mph-loop").textContent = loop.length
          ? `Your loop (${loop.map((x) => name(x.r)).join(" → ")}): ${fmt(pay)} expected every ${mmss(min)}, about ${fmt((pay / min) * 60)} per hour.` +
            (best && (pay / min) * 60 < best.rate ? ` That's less than doing ${name(best.r)} on its own, so only loop if the extra stops are on your way.` : "") +
            (locked.length ? ` Not unlocked yet: ${locked.join(", ")}.` : "")
          : "";
        plan(list, chap);
        try { localStorage.setItem(KEY, JSON.stringify({ ch: chap, loop: loop.map((x) => x.r.dataset.id), target: tIn.value, have: hIn.value })); } catch {}
      }
      const calcEl = document.getElementById("mph-calc");
      calcEl.addEventListener("input", (e) => calc(e.target.type !== "number"));
      calcEl.addEventListener("change", () => calc(true));
      document.querySelectorAll(".tgt").forEach((b) => b.addEventListener("click", () => { tIn.value = b.dataset.target; calc(); }));
      document.querySelectorAll("[data-preset]").forEach((b) => b.addEventListener("click", () => {
        const ids = b.dataset.preset ? b.dataset.preset.split(",") : [];
        rows.forEach((r) => (r.querySelector(".loop").checked = ids.includes(r.dataset.id)));
        calc();
      }));
      calc();
    })();
  </script>
</Article>

