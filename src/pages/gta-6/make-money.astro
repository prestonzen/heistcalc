---
import Article from "../../layouts/Article.astro";
import Share from "../../components/Share.astro";

// Calculator rows: id, name, chapter it unlocks (1-5), default payout, default minutes per run,
// reported range, where the time comes from, notes. Minutes marked "est" are our rough estimate.
const acts = [
  { id: "vault", name: "Large bank vaults", ch: 4, diff: 3, pay: 130000, min: 10, range: "$65,000–205,000", time: "~5 min inside + escape (est)", note: "Instant 4-star wanted level. Banks reset after a cooldown." },
  { id: "randy", name: "Randy's Wish List supercars", ch: 3, diff: 2, pay: 30000, min: 15, range: "$30,000–35,000", time: "est: find, clone key, deliver", note: "Needs the Key Cloner. The list is limited (16–22 cars). Damage cuts the price." },
  { id: "bank", name: "Small banks", ch: 3, diff: 3, pay: 15000, min: 8, range: "$5,000–45,000", time: "est", note: "Police arrive in about 20 seconds. Marked bills need the Dye Pack Jammer and a fence." },
  { id: "jewel", name: "Jewelry stores & pawn shops (smash and grab)", ch: 2, diff: 3, pay: 6000, ok: 75, fail: 0, min: 10, range: "$14,000–25,000 full take at the 4–6 biggest stores (seen on our stream); small shops only a few hundred", time: "est", note: "Map take values are a ceiling: our Florence & Co. run (listed $4,500–12,000, no safe) paid about $2,250 and Buck's (with a small lockbox) about $700, so the default here is a cautious $6,000 until we've tested a store with a safe. Pick Fence loot in the partner menu to skip the fence drive. Open from Chapter 2 (checked on our stream). Smashing cases brings the cops before you can grab everything, so the quick win is the safe: get the code from the staff, take the cash and bank it at an ATM. Jewelry still needs a fence. A repeat visit pays less until the store restocks. See all 16 locations with security and take values in our Smash and Grab guide (link above the table)." },
  { id: "yago", name: "Yago street races", ch: 3, diff: 2, pay: 2300, ok: null, fail: 750, min: 5, range: "$3,000 for 1st, minus a $600–900 car rental (reported); later races up to $6,000", time: "est", note: "Unlocks after Dealer's Choice. Prize money, no police." },
  { id: "glitch", name: "Warehouse stash save-reload loop (exploit)", ch: 1, diff: 1, pay: 5000, min: 10, range: "$4,000–10,000 per loop (reported, sources disagree)", time: "~10 min (reported)", note: "Reported exploit near Hamlet (red barn / Apollo Aggregates). Not tested by us and may get patched. Chapter 1 cash is wiped at Tourist Trap." },
  { id: "payday", name: "Payday Loans stores", ch: 3, diff: 2, pay: 10000, min: 8, range: "$2,000–25,000 (most $5,000–15,000)", time: "est", note: "Marked bills need a fence." },
  { id: "derby8", name: "Demolition Derby: figure-8 track (ramp-camp method)", ch: 2, diff: 1, pay: 2685, ok: 98, fail: 465, min: 2, range: "$3,150 for 1st place minus the $465 cheapest rental (our stream; $3,150 is the in-game max)", time: "2 min realistic average; fastest win 1:18 (our stream)", note: "Easy only with the ramp-camp method; without it, it's a hard wreck-fest. Last car standing. Pays about double the oval. Tested strategy: drive the wrong way to the crossover ramp, park on top and let the AI launch itself off you. Fastest win 1:18. 2nd place still pays $1,500." },
  { id: "derby8duo", name: "Demolition Derby: figure-8 with your partner (ramp-camp method)", ch: 2, diff: 1, pay: 5370, ok: 98, fail: 700, min: 2, range: "Up to $6,300 for 1st with Lucia or Jason in the race, minus $930 rental for both cars (our stream)", time: "2 min realistic average; a little extra partner dialogue between runs", note: "Bring your partner and the payout doubles: up to $6,300 for $930 in rentals. Same ramp method: drive the wrong way to the crossover ramp and park on top. With the $15,000 BuckMe cap early in Chapter 2, spend after about three wins." },
  { id: "derby", name: "Demolition Derby: oval", ch: 2, diff: 3, pay: 1400, ok: 90, fail: 500, min: 6, range: "$1,900 top prize at the start (seen on our stream), minus a rental of about $500; the in-game menu shows $1,900 max", time: "5–6 min (reported)", note: "Last car standing, not a race: you win by being the only car still running. You only get paid if you win. Retrying costs less than the first rental. Lower the payout if you don't win every time." },
  { id: "spray", name: "Pay 'n' Spray car sales", ch: 3, diff: 2, pay: 3500, min: 8, range: "$2,500–4,000+", time: "est", note: "Cars with a standard tracker. Lose the cops first." },
  { id: "dive", name: "Kenton's treasure dives", ch: 1, diff: 1, pay: 3000, min: 10, range: "$1,400 to about $4,000", time: "est", note: "Almost no risk. Only one source so far." },
  { id: "moses", name: "Stolen cars to Moses", ch: 2, diff: 1, pay: 1500, min: 4, range: "$1,000–2,000 (some say up to $3,000)", time: "3–5 min incl. ~2-min cooldown (reported)", note: "Untracked cars only, none stolen near his garage." },
  { id: "hunt", name: "Hunting for Bret", ch: 2, diff: 1, pay: 1500, min: 8, range: "$500 to a few thousand per animal", time: "est", note: "Jason only. Good or Pristine condition only." },
  { id: "store", name: "Store and gas station robberies", ch: 1, diff: 1, pay: 500, min: 3, range: "$100–300 register, plus a few hundred from the safe", time: "est", note: "1–2 stars. The store closes for a while afterwards." },
];
const once = [
  ["End of Chapter 3", "$120,000 (automatic)"],
  ["Pilot Pete's jobs (Chapter 4, Jason)", "$12,000 + $20,000 + $20,000"],
  ["Help Kirk Find Mr. Mangrove", "$5,000 if you shoot Mr. Mangrove (seen on our stream; some guides say $10,000)"],
  ["Shirley's rum stash", "About $1,300"],
  ["Crab research outpost safe (code 0072)", "About $1,000 plus a unique SMG"],
];
const faq = [
  { q: "What's the best money per hour in GTA 6?", a: "For almost the whole game, our Demolition Derby cheese with your partner: up to $6,300 a win for $930 in rentals, about 2 minutes a race, roughly $157,000 an hour, with no police. Only the large bank vaults at the end of Chapter 4 may beat it, if the $65,000–205,000 per vault that guides report holds up." },
  { q: "What's the fastest way to make money early in GTA 6?", a: "In Chapter 1, don't grind, because your cash is wiped at Tourist Trap. In Chapter 2, sell untracked cars to Moses ($1,000–2,000 each, a few minutes per car). Figure-8 Demolition Derbies are the best: bring Lucia and a win pays up to $6,300 for $930 in rentals ($3,150 and $465 solo), and a race averages about 2 minutes with the ramp method, roughly $157,000 an hour with your partner. You win by being the last car running, not by speed." },
  { q: "How much cash can you carry in GTA 6?", a: "$20,000 in pocket cash per character. Getting wasted or busted can cost you what you carry, so bank it at an ATM before risky jobs." },
  { q: "Can you sell fish in GTA 6?", a: "No. Fishing is catch-and-release, so it doesn't pay. Hunting does: Bret buys animals in good condition." },
  { q: "Is there a money cheat in GTA 6?", a: "Yes, +$250,000, but it only unlocks after the story, and using cheats blocks saving, so the money doesn't stay. See our cheat codes page." },
];
---
<Article
  title="GTA 6 Money Per Hour Calculator: Best Ways to Make Money"
  h1="GTA 6 Money Guide and Money Per Hour Calculator"
  description="Which GTA 6 activities make the most money per hour: bank vaults, Randy's supercars, jewelry stores, Moses car sales, Demolition Derby and more, with a calculator you can set to your own run times."
  published="2026-11-20"
  updated="2026-11-23"
  crumbs={[{ href: "/gta-6/", label: "GTA 6" }]}
  faq={faq}
  tool={{ name: "GTA 6 Money Per Hour Calculator" }}
  sources={[
    { href: "https://www.powerpyx.com/gta-6-money-guide-how-to-get-money-fast/", label: "PowerPyx: money guide" },
    { href: "https://www.gtabase.com/gta-6/articles/how-to-make-money-fast-in-gta-6", label: "GTABase: how to make money fast" },
    { href: "https://outputlag.com/guides/gta-6-make-money-fast/", label: "Output Lag: make money fast" },
    { href: "https://outputlag.com/guides/gta-6-how-to-rob-stores-heists/", label: "Output Lag: robbing stores" },
    { href: "https://timesaver.gg/tools/gta-6/money/bank-vaults", label: "Timesaver: bank vault payouts" },
    { href: "https://egamers.io/how-to-rob-banks-in-gta-6/", label: "eGamers: robbing banks" },
    { href: "https://www.gamerfuzion.com/gta-6-money-guide-how-to-make-money-fast", label: "GamerFuzion: money guide" },
    { href: "https://www.gtabase.com/gta-6/strangers/petes-deliveries-southpoint-airfield", label: "GTABase: Pete's Deliveries" },
  ]}
>
  <section slot="tool" class="calc" id="mph-calc">
    <h2>Money per hour calculator</h2>
    <a href="/gta-6/demolition-derby/" class="callout" style="display:block;text-decoration:none;border-color:var(--money);margin:12px 0"><strong>🔥 The best money in GTA 6 for almost the whole game: our Demolition Derby cheese.</strong> Bring Lucia and a win pays up to $6,300 ($5,370 after rentals). Park on the figure-8 ramp, about 2 minutes a race: roughly $157,000 an hour. <u>Read the guide →</u></a>
    <a href="/gta-6/smash-and-grab/" class="callout" style="display:block;text-decoration:none;margin:12px 0"><strong>New: all 16 Smash and Grab locations.</strong> Every jewelry store and pawn shop with its security level and take value, read off the in-game map. <u>See the list →</u></a>
    <p><small>Payouts are the middle of what guides report. Most run times are our estimates, because nobody has published timed runs yet. Change any number to match your own runs; the ranking updates when you click out of the box.</small></p>
    <fieldset id="chaps" style="border:1px solid var(--line);border-radius:10px;padding:10px 14px">
      <legend><small>Chapters I've unlocked</small></legend>
      <div style="display:flex;flex-wrap:wrap;gap:16px">
        {[1, 2, 3, 4, 5].map((n) => <label class="check"><input type="checkbox" value={n} checked={n <= 2} /> {n === 5 ? "Ch 5 / story done" : `Ch ${n}`}</label>)}
      </div>
    </fieldset>
    <p style="margin-top:12px"><small><strong>Potential</strong> is what you'd make if every run worked. <strong>Expected</strong> is the realistic average: payout × success rate, minus what a failed run costs you (for the Derby, the retry fee: $700 with your partner). The ranking uses Expected. Set the success rate to your own: once you have the Derby ramp down it's about 98%, almost guaranteed unless you have to hunt down a straggler.</small></p>
    <p style="margin-top:4px"><small><strong>Difficulty:</strong> Easy = little risk, Medium = police chase or a careful delivery, Hard = high wanted level or you only get paid if you win.</small></p>
    <p style="margin-top:4px"><small>Tick <strong>Loop</strong> on the activities you chain together (for example, rob a store on the way to Moses with a stolen car) to see what the whole rotation earns per hour.</small></p>
    <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:4px">
      <button type="button" class="btn-ghost" style="padding:6px 12px;font-size:.85rem" data-preset="moses,store">Chapter 2: cars + stick-ups</button>
      <button type="button" class="btn-ghost" style="padding:6px 12px;font-size:.85rem" data-preset="derby8duo,moses">Chapter 2: figure-8 Derby with Lucia + a car to Moses</button>
      <button type="button" class="btn-ghost" style="padding:6px 12px;font-size:.85rem" data-preset="randy,jewel,spray">Chapter 3: supercars + jewelry</button>
      <button type="button" class="btn-ghost" style="padding:6px 12px;font-size:.85rem" data-preset="">Clear loop</button>
    </div>
    <div id="mph-rows" class="acts">
      {acts.map((a) => (
        <article class="act" data-id={a.id} data-ch={a.ch} data-diff={a.diff}>
          <div class="act-head">
            <span class="rank"></span>
            <div class="act-title">
              <strong class="act-name">{a.name}</strong>
              <span class="act-tags"><span class={`diff d${a.diff}`}>{["", "Easy", "Medium", "Hard"][a.diff]}</span> <span class="act-ch">Ch {a.ch}+</span>{a.ok == null && <span class="act-ch">untested</span>}</span>
            </div>
            <label class="act-loop"><input type="checkbox" class="loop" aria-label={`Add ${a.name} to my loop`} /> Loop</label>
          </div>
          <div class="act-body">
            <div class="act-inputs">
              <label>Payout ($)<input class="pay" type="number" min="0" step="100" value={a.pay} inputmode="numeric" /></label>
              <label>Success %<input class="ok" type="number" min="0" max="100" step="1" value={a.ok ?? 75} inputmode="numeric" /></label>
              <label>Lost on a fail ($)<input class="fail" type="number" min="0" step="50" value={a.fail ?? 0} inputmode="numeric" /></label>
              <label>Time per run<span class="act-time"><input class="mm" type="number" min="0" step="1" value={Math.floor(a.min)} inputmode="numeric" aria-label={`${a.name} minutes`} /><b>:</b><input class="ss" type="number" min="0" max="59" step="1" value={String(Math.round((a.min % 1) * 60)).padStart(2, "0")} inputmode="numeric" aria-label={`${a.name} seconds`} /></span></label>
            </div>
            <div class="act-out">
              <div><small>Expected / hr</small><strong class="rate">-</strong></div>
              <div><small>Potential / hr</small><span class="pot">-</span></div>
            </div>
          </div>
          <details class="act-more"><summary>Details</summary><p><small><strong>Reported:</strong> {a.range}. <strong>Time:</strong> {a.time}. {a.note}</small></p></details>
        </article>
      ))}
    </div>
    <p id="mph-best" style="margin-top:12px"></p>
    <p id="mph-loop" style="margin-top:4px"></p>
    <Share target="mph-calc" />
  </section>

  <div class="callout"><p><strong>These are reported payouts, not HeistCalc-verified numbers</strong>, except where we say we saw it on stream. Guides are only days old and often disagree, so this page shows the range and gets updated as numbers settle.</p></div>

  <h2>Best money by chapter</h2>
  <ul>
    <li><strong>Chapter 1:</strong> don't grind. Your cash, checking and car are wiped at Tourist Trap. Move up to $5,000 into Family Savings (see the <a href="/gta-6/buckme/">BuckMe calculator</a>) and spend the rest.</li>
    <li><strong>Chapter 2:</strong> figure-8 Demolition Derbies with your partner (up to $6,300 a win, about $157,000 an hour at a 2-minute average; $3,150 solo) and untracked cars to Moses. Jewelry stores and pawn shops also open for smash and grab in Chapter 2 (checked on our stream); the bigger ones hold $14,000–25,000, and grabbing the safe cash beats smashing every case before the cops arrive. Hunting for Bret is a quieter option for Jason. The oval derby barely beats its rental fee.</li>
    <li><strong>Chapter 3:</strong> the Derby with your partner is still the best money (about $157,000 an hour). After that, Randy's Wish List supercars, then banks and Payday Loans, with jewelry stores still worth a hit. Pay 'n' Spray takes cars Moses won't, and vans pay well there: a stolen U.S. National Mail Service van sold for $2,750 and a Vapid Speedo van for $1,800 on our stream.</li>
    <li><strong>Chapter 4 and after the story:</strong> large bank vaults beat everything else by a wide margin.</li>
  </ul>

  <h2>A Chapter 2 money rotation</h2>
  <p>On its own, Moses can only buy a car every couple of minutes, so the trick is filling that cooldown with something on the way:</p>
  <ol>
    <li><strong>Steal an untracked car far from Port Gellhorn.</strong> Moses won't buy cars stolen near his garage, and anything with a tracker is a Pay 'n' Spray job for Chapter 3.</li>
    <li><strong>Hit a store on the drive over</strong> if one is on your route. It's only a few hundred dollars, so don't detour for it, and don't wreck the car escaping: damage cuts Moses's price.</li>
    <li><strong>Sell to Moses</strong> for about $1,000–2,000, then go find the next car while his cooldown runs.</li>
    <li><strong>Selling the cars in your garage:</strong> Moses will buy them, but not from the normal menu. Drive in with any car, pick <strong>Services</strong> (not "Sell current car"), then choose <strong>Sell all</strong>. That sells your garage cars in one go (checked on our stream).</li>
    <li><strong>Better yet, grind figure-8 Demolition Derbies.</strong> Bring Lucia: up to $6,300 for 1st minus $930 in rentals, about 2 minutes a race: several times what car sales make per hour. You win by surviving, not by speed. Grab a car to sell to Moses on your way out.</li>
  </ol>
  <h3 id="moses-delivery-trick">Trick: deliver a car to Moses without driving it there</h3>
  <p>Found on our stream with Moses's '74 Declasse Vamos job (2.4 miles from Grayson to Watkins Auto Parts). Your partner can bring the car over almost instantly:</p>
  <ol>
    <li>Put your partner in the car you're delivering, driving it.</li>
    <li>Get out and order a RydeMe to Moses at Watkins Auto Parts, then skip the ride.</li>
    <li>When you arrive, open the partner menu and pick <strong>Drive here</strong>. Your partner pulls up with the car a few seconds later, so you can drive it into Moses's garage.</li>
  </ol>
  <p>You skip the long drive and the risk of damaging the car on the way, and damage cuts Moses's price. The Vamos sold for $4,200.</p>
  <p>Bank your cash at an ATM every few runs, because you can only carry $20,000 and dying or getting busted costs what's in your pocket. Use the Loop buttons in the calculator with your own times to see which rotation actually pays best for you.</p>

  <h2>How to win Demolition Derby</h2>
  <p>We tested it on stream. The Derby isn't a race: lap times and top speed don't matter. You win by being the last car still running, and the AI makes that easy:</p>
  <ul>
    <li><strong>Rent the '72 Tulip.</strong> It's the car that worked for us.</li>
    <li><strong>Camp.</strong> Hang back and let the AI cars pile into each other. They don't come hunting for you.</li>
    <li><strong>Ram in reverse.</strong> Back into the damaged cars to finish them off. Hitting with your rear keeps your engine alive, and the AI doesn't react to it.</li>
    <li><strong>Retry until you win.</strong> 2nd place still pays $1,500, and a retry is $315, half the $615 rental, so keep retrying until you finish 1st.</li>
    <li><strong>Pick the figure-8 track.</strong> 1st place pays $3,150, the maximum the game lists, about double the oval's $1,900. Full guide: <a href="/gta-6/demolition-derby/">how to win the Demolition Derby</a>.</li>
    <li><strong>The numbers we got:</strong> $3,150 prize minus the $465 cheapest rental is $2,685 profit, and a race averages about 2 minutes. At a realistic 2-minute average that's about $78,000 an hour solo. <strong>Bring Lucia and it doubles:</strong> up to $6,300 a win for $930 in rentals, about $157,000 an hour, the best money in the game until the bank vaults at the end of Chapter 4. 2nd place still pays $1,500 and a retry costs only $315 (half the rental). So coming 2nd isn't a loss: 2nd place, then a retry you win, nets about $3,700 for two rounds.</li>
  </ul>

  <h2>One-time payouts worth knowing</h2>
  <div class="table-scroll"><table>
    <thead><tr><th>Source</th><th>Payout</th></tr></thead>
    <tbody>{once.map(([s, p]) => <tr><td><strong>{s}</strong></td><td>{p}</td></tr>)}</tbody>
  </table></div>

  <h2>Cash rules that cost players money</h2>
  <ul>
    <li><strong>Chapter 1 cash doesn't carry over.</strong> Spend it or save it in Family Savings before Tourist Trap.</li>
    <li><strong>You can carry $20,000.</strong> Bank the rest at an ATM. Getting wasted or busted can cost you what's in your pocket.</li>
    <li><strong>Checking has a limit.</strong> It starts at $15,000, and when it's full new payments wait until there's room. In Chapter 2, once heists are unlocked and Family Savings is filled, checking and Family Savings both go up to $100,000 (checked on our stream). See the <a href="/gta-6/buckme/">BuckMe guide</a>.</li>
    <li><strong>Time to cash matters.</strong> Safe cash can go straight into an ATM, but jewelry and marked bills still need a trip to a fence. Taxi fast travel doesn't work after a crime in the area, so you drive that leg with the cops around. On a robbery, the safe-and-ATM route turns into spendable money fastest.</li>
    <li><strong>Yasmani's security van tips cost $10,000 each.</strong> They're a cost, not income, and they unlock after you rob 2 Payday Loans stores.</li>
    <li><strong>Fishing doesn't pay.</strong> It's catch-and-release only.</li>
    <li><strong>Robbery safes need codes.</strong> All known codes are on our <a href="/gta-6/safe-codes/">safe codes page</a>.</li>
  </ul>
  <p>More: the <a href="/gta-6/fastest-cars/">fastest cars and where to find them</a>, <a href="/gta-6/collectibles/">collectibles</a> (duplicate cards sell at pawn shops) and <a href="/gta-6/heists/">GTA 6 heists</a>.</p>

  <script is:inline>
    (() => {
      const rows = [...document.querySelectorAll("#mph-rows .act")];
      const boxes = [...document.querySelectorAll("#chaps input")];
      const fmt = (n) => "$" + Math.round(n).toLocaleString("en-US");
      const KEY = "hc-gta6-mph";
      const name = (r) => r.querySelector(".act-name").textContent;
      try {
        const saved = JSON.parse(localStorage.getItem(KEY) || "null");
        if (saved) {
          boxes.forEach((b) => (b.checked = saved.ch.includes(Number(b.value))));
          rows.forEach((r) => (r.querySelector(".loop").checked = saved.loop.includes(r.dataset.id)));
        }
      } catch {}
      // resort=false while typing, so rows don't jump under your cursor; the table re-ranks when you leave the box or press Enter.
      function calc(resort = true) {
        const unlocked = new Set(boxes.filter((b) => b.checked).map((b) => Number(b.value)));
        const list = rows.map((r) => {
          const win = Math.max(0, Number(r.querySelector(".pay").value) || 0);
          const ok = Math.min(100, Math.max(0, Number(r.querySelector(".ok").value) || 0)) / 100;
          const lose = Math.max(0, Number(r.querySelector(".fail").value) || 0);
          const pay = win * ok - lose * (1 - ok); // expected money per attempt
          const secs = Math.max(10, (Number(r.querySelector(".mm").value) || 0) * 60 + (Number(r.querySelector(".ss").value) || 0));
          const min = secs / 60;
          const rate = (pay / secs) * 3600;
          r.querySelector(".rate").textContent = fmt(rate);
          r.querySelector(".pot").textContent = fmt((win / secs) * 3600);
          const open = unlocked.has(Number(r.dataset.ch));
          r.style.opacity = open ? "1" : "0.4";
          return { r, rate, open, pay, min, loop: r.querySelector(".loop").checked };
        });
        list.sort((a, b) => (b.open - a.open) || (b.rate - a.rate));
        if (resort) {
          const body = document.getElementById("mph-rows");
          list.forEach((x, i) => { body.appendChild(x.r); x.r.querySelector(".rank").textContent = x.open ? String(i + 1) : "🔒"; });
        }
        const best = list.find((x) => x.open);
        document.getElementById("mph-best").textContent = best
          ? `Best single activity for you: ${name(best.r)} at about ${fmt(best.rate)} per hour expected. Greyed rows are in chapters you haven't ticked.`
          : "Tick the chapters you've unlocked.";
        const loop = list.filter((x) => x.loop);
        const pay = loop.reduce((s, x) => s + x.pay, 0), min = loop.reduce((s, x) => s + x.min, 0);
        const mmss = (m) => { const t = Math.round(m * 60); return `${Math.floor(t / 60)}:${String(t % 60).padStart(2, "0")}`; };
        const locked = loop.filter((x) => !x.open).map((x) => name(x.r));
        document.getElementById("mph-loop").textContent = loop.length
          ? `Your loop (${loop.map((x) => name(x.r)).join(" → ")}): ${fmt(pay)} expected every ${mmss(min)}, about ${fmt((pay / min) * 60)} per hour.` +
            (best && (pay / min) * 60 < best.rate ? ` That's less than doing ${name(best.r)} on its own, so only loop if the extra stops are on your way.` : "") +
            (locked.length ? ` Not unlocked yet: ${locked.join(", ")}.` : "")
          : "";
        try { localStorage.setItem(KEY, JSON.stringify({ ch: [...unlocked], loop: loop.map((x) => x.r.dataset.id) })); } catch {}
      }
      const calcEl = document.getElementById("mph-calc");
      calcEl.addEventListener("input", (e) => calc(e.target.type !== "number"));
      calcEl.addEventListener("change", () => calc(true));
      document.querySelectorAll("[data-preset]").forEach((b) => b.addEventListener("click", () => {
        const ids = b.dataset.preset ? b.dataset.preset.split(",") : [];
        rows.forEach((r) => (r.querySelector(".loop").checked = ids.includes(r.dataset.id)));
        calc();
      }));
      calc();
    })();
  </script>
</Article>

<style>
  .acts { display: grid; gap: 10px; margin-top: 16px; }
