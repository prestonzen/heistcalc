---
import Article from "../../layouts/Article.astro";

const faq = [
  { q: "How do I preload GTA 6?", a: "Pre-order the digital version on the account you play on, free up at least 212 GB, turn on automatic downloads (PS5) or automatic updates (Xbox), and leave the console on or in Rest Mode or Sleep. The download starts once preloading opens in your region." },
  { q: "When can I preload GTA 6?", a: "From November 10, 2026. On PS5 it opens at midnight local time. On Xbox Series X|S it opens worldwide at 12:00 AM GMT on November 10, which is 7:00 PM ET and 4:00 PM PT on November 9 in the US." },
  { q: "How big is the GTA 6 download?", a: "Rockstar lists up to 212 GB of available space, depending on your device. Leave extra room in case a launch-day patch adds to it." },
  { q: "Can I play GTA 6 as soon as the preload finishes?", a: "No. Preloading only downloads the game. Rockstar says it releases at midnight local time on November 19, 2026." },
  { q: "Can I preload the boxed version of GTA 6?", a: "Yes, once you have it. Code-in-box copies are due at retailers from November 12. There is no disc: redeem the code on the account you play on and the same download starts." },
  { q: "Why won't my GTA 6 preload start?", a: "Check that you're signed in to the account that bought the game, that you have 212 GB free, that automatic downloads are on, and that the console isn't fully shut down. On PS5 you can also pause and resume the download from Downloads/Uploads in the control center." },
  { q: "Can I still cancel a GTA 6 pre-order after preloading?", a: "On PlayStation Store you can cancel and get a refund before the game releases. After release, a refund is only available if the content hasn't started to download, so a preloaded copy is hard to refund after November 19." },
];

const usable = [
  ["PS5 (original, 825 GB)", "~667 GB"],
  ["PS5 Slim (1 TB)", "~848 GB"],
  ["Xbox Series X (1 TB)", "~802 GB"],
  ["Xbox Series S (512 GB)", "~364 GB"],
];
const xbox = [
  ["US West (PT)", "Mon Nov 9, 4:00 PM"],
  ["US East (ET)", "Mon Nov 9, 7:00 PM"],
  ["UK (GMT)", "Tue Nov 10, 12:00 AM"],
  ["Central Europe (CET)", "Tue Nov 10, 1:00 AM"],
  ["Japan (JST)", "Tue Nov 10, 9:00 AM"],
  ["Australia East (AEDT)", "Tue Nov 10, 11:00 AM"],
];
---
<Article
  title="How to Preload GTA 6 on PS5 and Xbox (Nov 10 Guide)"
  h1="How to Preload GTA 6 So You Can Play the Moment It Unlocks"
  description="Step-by-step GTA 6 preload guide for PS5 and Xbox: Nov 10 start times, 212 GB space, auto-download settings, a download time calculator, and fixes if it won't start."
  published="2026-11-05"
  updated="2026-11-10"
  crumbs={[{ href: "/gta-6/", label: "GTA 6" }]}
  faq={faq}
  tool={{ name: "GTA 6 Download Time Calculator" }}
  sources={[
    { href: "https://support.rockstargames.com/articles/7nPqOA2uCbpEQHXx7KVrYd/grand-theft-auto-vi-pre-load-faq", label: "Rockstar Support: GTA VI Pre-Load FAQ" },
    { href: "https://support.rockstargames.com/articles/29jV3Cv2cCgvwM1XgtMO5o/grand-theft-auto-vi-regional-pre-load-and-release-times-on-playstation-5-and-xbox-series-x-or-s", label: "Rockstar Support: regional pre-load and release times" },
    { href: "https://www.rockstargames.com/newswire/article/k4ak9okk485712/grand-theft-auto-vi-pre-load-begins-on-november-10", label: "Rockstar Newswire: pre-load begins November 10" },
    { href: "https://blog.playstation.com/2026/11/03/grand-theft-auto-vi-pre-download-begins-november-10/", label: "PlayStation.Blog: GTA VI pre-download" },
    { href: "https://www.playstation.com/en-us/support/games/pre-order-games-automatic-download-ps-store/", label: "PlayStation Support: pre-order and auto-download" },
    { href: "https://www.playstation.com/en-us/support/games/troubleshoot-downloaded-playstation-game/", label: "PlayStation Support: troubleshoot game downloads" },
  ]}
>
  <section slot="tool" class="calc" id="dl-calc">
    <h2>Will your download finish in time?</h2>
    <div class="calc-grid">
      <div class="field"><label for="dl-platform">Console</label>
        <select id="dl-platform"><option value="ps5">PlayStation 5</option><option value="xbox">Xbox Series X|S</option></select></div>
      <div class="field"><label for="dl-speed">Download speed (Mbps)</label><input id="dl-speed" type="number" min="1" step="1" value="100" inputmode="numeric" /><small>Run a speed test on the console for the real number</small></div>
      <div class="field"><label for="dl-size">Download size (GB)</label><input id="dl-size" type="number" min="1" step="1" value="212" inputmode="numeric" /><small>Rockstar's figure is up to 212 GB</small></div>
    </div>
    <div class="table-scroll" style="margin-top:16px"><table>
      <tbody>
        <tr><td>Preload status</td><td id="dl-status">Enter your details</td></tr>
        <tr><td>Estimated download time</td><td id="dl-time">-</td></tr>
        <tr><td>Finishes around</td><td id="dl-finish">-</td></tr>
        <tr><td>Latest safe start</td><td id="dl-latest">-</td></tr>
      </tbody>
    </table></div>
    <p class="warn" id="dl-verdict" style="color:var(--muted)" aria-live="polite"></p>
    <p class="muted-sm">Assumes you get about 80% of your line speed, and shows times in your own time zone. A launch-day patch would add to this.</p>
  </section>

  <p><strong>GTA 6 preloading opens on November 10, 2026, nine days before launch.</strong> Preload and the game is already on your console when it unlocks, so you can start playing right away instead of waiting on a 212 GB download with everyone else. Here's how to set it up.</p>

  <h2>When preloading opens</h2>
  <p><strong>PS5:</strong> midnight local time on November 10, in your own time zone.</p>
  <p><strong>Xbox Series X|S:</strong> everywhere at once, at 12:00 AM GMT on November 10. In the Americas that's the evening of November 9:</p>
  <div class="table-scroll"><table>
    <thead><tr><th>Region</th><th>Xbox preload opens</th></tr></thead>
    <tbody>{xbox.map(([r, t]) => <tr><td>{r}</td><td>{t}</td></tr>)}</tbody>
  </table></div>
  <div class="callout"><p>Rockstar moved preloading up on November 3. Guides that say November 12 are out of date: that's now the day boxed copies reach stores. The game itself <a href="/gta-6/release-date/">unlocks November 19</a>.</p></div>

  <h2>How to preload on PS5</h2>
  <ol>
    <li><strong>Pre-order the digital version</strong> from PlayStation Store on the account you'll play on. Not sure which? See <a href="/gta-6/editions/">Standard vs Ultimate</a>.</li>
    <li><strong>Free up at least 212 GB</strong> on the console's internal SSD or an installed M.2 drive. Check under Settings → Storage. PS5 games can't run from a USB drive.</li>
    <li><strong>Keep the console online in Rest Mode.</strong> Go to Settings → System → Power Saving → Features Available in Rest Mode, and turn on Stay Connected to the Internet.</li>
    <li><strong>Turn on auto-download.</strong> Go to Settings → Saved Data and Game/App Settings → Automatic Updates, and turn on Auto-Download.</li>
    <li><strong>Check the game itself.</strong> From your games home, open Game Library and select GTA 6. Select the countdown timer, make sure the content is ticked, then select OK.</li>
    <li><strong>Leave the PS5 on or in Rest Mode</strong>, not fully powered off. The download starts when preloading opens.</li>
  </ol>

  <h2>How to preload on Xbox Series X|S</h2>
  <ol>
    <li><strong>Pre-order the digital version</strong> from the Microsoft Store on the account you'll play on.</li>
    <li><strong>Free up at least 212 GB</strong> on the internal drive or a Storage Expansion Card.</li>
    <li><strong>Turn on automatic updates.</strong> Go to Settings → System → Updates, and turn on keeping your games and apps up to date.</li>
    <li><strong>Use Sleep power mode.</strong> Go to Settings → General → Power options and pick Sleep. An Xbox set to Shutdown can't download while it's off.</li>
    <li><strong>Leave the console on or in Sleep.</strong> You can see progress under My games &amp; apps → Manage → Queue.</li>
  </ol>

  <h2>How much space do you need?</h2>
  <p>Rockstar lists <strong>up to 212 GB</strong> depending on your device, and PlayStation says to clear a minimum of 212 GB. Launch-day patches are common, so aim for about <strong>250 GB free</strong>. Approximate usable space by console:</p>
  <div class="table-scroll"><table>
    <thead><tr><th>Console</th><th class="num">Usable storage (approx.)</th></tr></thead>
    <tbody>{usable.map(([c, s]) => <tr><td>{c}</td><td class="num">{s}</td></tr>)}</tbody>
  </table></div>
  <p>On a <strong>Series S</strong>, GTA 6 takes more than half the drive, so plan on uninstalling other games or adding an expansion card.</p>

  <h2>Preload not working? Try these fixes</h2>
  <ul>
    <li><strong>Wrong account:</strong> sign in to the account that bought the game, and check your transaction history to confirm the purchase went through.</li>
    <li><strong>Too early:</strong> PS5 opens at your local midnight, so a game that won't download on November 9 is normal in most of the world.</li>
    <li><strong>PS5 download won't start:</strong> open Downloads/Uploads in the control center, then select Pause and Resume. If that fails, select Cancel and Delete, then start it again from your Game Library.</li>
    <li><strong>Not enough space:</strong> in your Game Library, select the game, then … → View Product to see the space required. Compare it with Settings → Storage.</li>
    <li><strong>Stuck download:</strong> check PlayStation Network or Xbox status for outages, since preload day is busy. Then test your connection and install any system update. On PS5, Rebuild Database in Safe Mode is the last resort.</li>
    <li><strong>Padlock icon on PS5:</strong> use Restore Licenses, and make sure Console Sharing and Offline Play is on for your account.</li>
    <li><strong>Xbox:</strong> check My games &amp; apps → Manage → Queue, and restart the console by holding the power button for 10 seconds.</li>
  </ul>

  <h2>Boxed copies</h2>
  <p>The code-in-box Standard Edition is due at retailers from <strong>November 12</strong>, and there's no disc inside. Redeem the code on your account and the same download starts, so you'll be about two days behind digital preloaders. Make sure the box matches your account's region, because codes are region-locked.</p>

  <h2>Changed your mind?</h2>
  <p>On PlayStation Store you can cancel a pre-order for a refund any time before release. After release, you can only request a refund if the game hasn't started downloading, within 14 days of pre-ordering. If you're on the fence, decide before November 19.</p>

  <h2>While it downloads</h2>
  <p>GTA Online's <a href="/gta-online-weekly-update/">Heist Event</a> is a good way to fill the wait. Run the numbers with the <a href="/cayo-perico-calculator/">Cayo Perico calculator</a>, or read <a href="/gta-6/heists/">what's confirmed about heists in GTA 6</a>.</p>

  <script is:inline>
    (() => {
      const $ = (id) => document.getElementById(id);
      const LAUNCH = new Date(2026, 10, 19, 0, 0, 0).getTime();
      const OPEN = { ps5: new Date(2026, 10, 10, 0, 0, 0).getTime(), xbox: Date.UTC(2026, 10, 10, 0, 0, 0) };
      const when = (t) => new Date(t).toLocaleString([], { weekday: "short", month: "short", day: "numeric", hour: "numeric", minute: "2-digit" });
      const span = (ms) => {
        const m = Math.round(ms / 60000), d = Math.floor(m / 1440), h = Math.floor((m % 1440) / 60), r = m % 60;
        return [d && `${d}d`, h && `${h}h`, !d && `${r}m`].filter(Boolean).join(" ") || "under a minute";
      };
      const render = () => {
        const speed = Number($("dl-speed").value), size = Number($("dl-size").value), open = OPEN[$("dl-platform").value], now = Date.now();
        $("dl-status").textContent = now >= open ? "Open now" : `Opens ${when(open)} (in ${span(open - now)})`;
        if (!(speed > 0) || !(size > 0)) {
          $("dl-time").textContent = $("dl-finish").textContent = $("dl-latest").textContent = "-";
          $("dl-verdict").textContent = "Enter your download speed and size.";
          return;
        }
        const dur = (size * 8000) / (speed * 0.8) * 1000;
        const start = Math.max(now, open), finish = start + dur, latest = LAUNCH - dur;
        $("dl-time").textContent = span(dur);
        $("dl-finish").textContent = when(finish);
        $("dl-latest").textContent = when(latest);
        if (now >= LAUNCH) $("dl-verdict").textContent = "GTA 6 is out, so this is just how long your download will take.";
        else if (finish <= LAUNCH) $("dl-verdict").textContent = `You'll be ready about ${span(LAUNCH - finish)} before your local midnight launch.`;
        else $("dl-verdict").textContent = `At this speed it would finish ${span(finish - LAUNCH)} after launch. Plug in Ethernet and start as soon as you can.`;
      };
      ["dl-platform", "dl-speed", "dl-size"].forEach((id) => $(id).addEventListener("input", render));
      render();
    })();
  </script>
</Article>
