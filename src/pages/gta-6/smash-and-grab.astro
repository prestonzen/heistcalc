---
import Article from "../../layouts/Article.astro";

// All values read off the in-game Robberies > Smash 'n' Grabs map menu on our stream (2026-11-22, Chapter 2).
// dist = miles shown in the menu from Ambrosia Raceway, where we opened it.
type Store = { slug: string; name: string; kind: string; sec: "Low" | "Medium"; lo: number; hi: number; dist: number; area: string };
const stores: Store[] = [
  { slug: "kowalski", name: "Kowalski", kind: "Large, high-end jewelry", sec: "Medium", lo: 14000, hi: 25000, dist: 1.73, area: "Waning Sands mall, next to Skala" },
  { slug: "skala", name: "Skala", kind: "Large, low-end jewelry", sec: "Medium", lo: 14000, hi: 25000, dist: 1.79, area: "Waning Sands mall, next to Kowalski" },
  { slug: "peacock", name: "Peacock", kind: "Small, low-end jewelry", sec: "Medium", lo: 9000, hi: 20000, dist: 3.3, area: "Vice City, by Panos Plaza" },
  { slug: "all-that-glitters", name: "All That Glitters", kind: "Small, low-end jewelry", sec: "Medium", lo: 9000, hi: 20000, dist: 3.35, area: "Vice City, by Panos Plaza" },
  { slug: "marshals", name: "Marshal's", kind: "Small, high-end jewelry", sec: "Medium", lo: 9000, hi: 20000, dist: 3.7, area: "Vice Beach" },
  { slug: "plush", name: "Plush", kind: "Small, high-end jewelry", sec: "Medium", lo: 9000, hi: 20000, dist: 3.84, area: "Tequesta" },
  { slug: "vice-city-pawn", name: "Vice City Pawn", kind: "Pawn shop", sec: "Low", lo: 4500, hi: 12000, dist: 2.65, area: "Vice City, near Panos Plaza" },
  { slug: "ernestos-pawn", name: "Ernesto's Pawn", kind: "Pawn shop", sec: "Low", lo: 4500, hi: 12000, dist: 4.35, area: "Vice City, near Peacock Estates" },
  { slug: "florence-co", name: "Florence & Co.", kind: "Pawn shop", sec: "Medium", lo: 4500, hi: 12000, dist: 0.17, area: "Ambrosia, next to the raceway" },
  { slug: "the-jewelry-place", name: "The Jewelry Place", kind: "Small, low-end jewelry", sec: "Low", lo: 1000, hi: 10000, dist: 2.52, area: "Vice-Dale" },
  { slug: "fast-cash", name: "Fast Cash", kind: "Pawn shop", sec: "Low", lo: 1000, hi: 10000, dist: 3.04, area: "Vice City" },
  { slug: "pawn-city", name: "Pawn City", kind: "Pawn shop", sec: "Low", lo: 1000, hi: 10000, dist: 3.47, area: "Vice City" },
  { slug: "sirens-chest", name: "The Siren's Chest", kind: "Small, low-end jewelry", sec: "Low", lo: 1000, hi: 10000, dist: 7.14, area: "Key Lento (guides); far out on the coast" },
  { slug: "icegem", name: "ICEGEM Diamonds & Watches", kind: "Large, low-end jewelry", sec: "Medium", lo: 5000, hi: 10000, dist: 3.4, area: "Downtown Vice City" },
  { slug: "richardson", name: "Richardson Jewelry & Diamonds", kind: "Large, low-end jewelry", sec: "Medium", lo: 2000, hi: 7000, dist: 3.35, area: "Vice City, by Panos Plaza" },
  { slug: "bucks-jewelry-pawn", name: "Buck's Jewelry & Pawn", kind: "Pawn shop", sec: "Low", lo: 500, hi: 5000, dist: 2.47, area: "Port Gellhorn" },
];
// Field notes, filled in as we hit each store on stream. Empty = not tested yet.
type Field = { hasSafe?: string; guards?: string; cases?: string; safe?: string; code?: string; cops?: string; take?: string; takeN?: number; takeShort?: string; notes?: string; pics?: { src: string; alt: string; cap: string }[] };
const field: Record<string, Field> = {
  "all-that-glitters": {
    hasSafe: "Yes, breakable (no code)",
    guards: "One armed security guard by the front door, and another came out of the back office.",
    cases: "About 10 cases around the counter plus the wall displays. A fast smash run filled a bag with $3,240 of jewelry.",
    safe: "A breakable floor safe in the back office, through the white door behind the counter.",
    code: "No code needed: you break it open.",
    cops: "Bad: the store is in the Bayside outdoor mall and police spawn right outside the door, across the walkway. 3 stars, and we were Wasted on the way to the car.",
    take: "About $5,500 on us before the cops: $2,255 cash from the register and safe, plus $3,240 of jewelry. Getting Wasted costs your pocket cash, so get out fast or skip this one.",
    takeShort: "~$5,500, lost",
    notes: "Tested 2026-11-22 on stream (we meant to hit Ernesto's Pawn). The partner menu here offered Distract law, worth trying against the cops out front.",
    pics: [
      { src: "/img/gta-6/sg/all-that-glitters-guard.webp", alt: "Armed security guard standing by the front door inside All That Glitters jewelry store in GTA 6", cap: "One armed guard stands by the door, so deal with him first." },
      { src: "/img/gta-6/sg/all-that-glitters-cases.webp", alt: "Jason filling a bag from the display cases in All That Glitters, GTA 6, with $3,240 of jewelry on screen", cap: "A quick smash run: $3,240 of jewelry in the bag plus $2,437 cash on Jason." },
      { src: "/img/gta-6/sg/all-that-glitters-safe.webp", alt: "Jason at the safe in the back office of All That Glitters in GTA 6", cap: "The safe is in the back office, through the white door behind the counter." },
      { src: "/img/gta-6/sg/all-that-glitters-cops-outside.webp", alt: "Police right outside All That Glitters in the Bayside outdoor mall in GTA 6 as Jason runs to the car", cap: "The problem: police spawn right outside in the mall walkway." },
    ],
  },
  "bucks-jewelry-pawn": {
    hasSafe: "Yes, lockbox (no code)",
    guards: "None seen. A clerk at the counter, plus a worker in the back office.",
    cases: "A few cases along the counter, plus the register (about $50).",
    safe: "Small cash lockbox on a desk in the back office, behind a red Staff Only door you break open. It gave $578. The storage room next to it also had a Gold collectible card.",
    code: "No code needed: the lockbox opens on the spot.",
    cops: "Crime reported about 40 seconds after we threatened the clerk.",
    take: "About $700 in cash ($578 lockbox, the rest from the register and a case) plus a Gold collectible card. Inside the map's $500–5,000 range, but low.",
    takeN: 700,
    notes: "Port Gellhorn. After the robbery the map shows it as Currently closed. Tested 2026-11-22 on stream.",
    pics: [
      { src: "/img/gta-6/sg/bucks-staff-only-door.webp", alt: "Red Staff Only door with a Break open prompt inside Buck's Jewelry & Pawn in GTA 6", cap: "Break open the red Staff Only door behind the counter to reach the back office." },
      { src: "/img/gta-6/sg/bucks-lockbox.webp", alt: "Small black cash lockbox on a desk in the back office of Buck's Jewelry & Pawn, GTA 6", cap: "The safe: a small cash lockbox on the office desk. $578 for us." },
    ],
  },
  "florence-co": {
    hasSafe: "No",
    guards: "No armed guard inside on our visit. Staff behind the main counter and at the Jewelry Repairs desk.",
    cases: "About 10 glass cases around a U-shaped counter, plus the register.",
    safe: "None. No staff back office either: just a security panel on the staff side of the counter.",
    code: "No safe here.",
    cops: "3 stars about 30 seconds after the first smashed case.",
    take: "About $2,250: $1,760 for the jewelry (our partner fenced it at Dunk's Trailer and the full $1,760 came through) plus about $500 from the register. Half the $4,500 minimum the map lists.",
    takeN: 2250,
    notes: "Lucia took the second bag (Hand over bag), and we sent her to fence it with Fence loot. Tested 2026-11-22 on stream.",
    pics: [
      { src: "/img/gta-6/sg/florence-co-cases.webp", alt: "Smashing the glass display cases inside Florence & Co. in GTA 6, with jewelry values popping up", cap: "Inside: about 10 cases around the counter. Each smash adds $30–190 of jewelry." },
      { src: "/img/gta-6/sg/florence-co-fence-dunk.webp", alt: "GTA 6 map card for Dunk's Trailer showing jewelry worth $1,760 at a low rate", cap: "Dunk's Trailer valued the jewelry at $1,760, at his Low rate." },
    ],
  },
  icegem: { notes: "Robbed once on stream before this list; it now shows under Previously Hit with a lower take ($5,000–10,000)." },
  richardson: { notes: "The map card lists a Features icon that no other store shows. We'll check what it is on our visit." },
};
const rows: [keyof Field, string][] = [["hasSafe", "Has a safe?"], ["guards", "Guards"], ["cases", "Display cases"], ["safe", "Safe"], ["code", "Safe code"], ["cops", "Cops arrive"], ["take", "Our take"]];
const money = (n: number) => "$" + n.toLocaleString("en-US");
const shots = [
  { src: "/img/gta-6/smash-grab-kowalski.webp", alt: "GTA 6 Robberies map menu showing Kowalski, a large high-end jewelry store, medium security, take value $14,000 to $25,000", cap: "Kowalski: medium security, $14,000–25,000. Skala is in the same mall with the same take." },
  { src: "/img/gta-6/smash-grab-vice-city-pawn.webp", alt: "GTA 6 Robberies map menu showing Vice City Pawn, a pawn shop with low security and take value $4,500 to $12,000", cap: "Vice City Pawn: low security, $4,500–12,000. The best take of any low-security store." },
  { src: "/img/gta-6/smash-grab-peacock.webp", alt: "GTA 6 Robberies map menu showing Peacock jewelry store, medium security, take value $9,000 to $20,000", cap: "Peacock: medium security, $9,000–20,000, one of four stores in that bracket." },
];
const faq = [
  { q: "How many jewelry stores can you rob in GTA 6?", a: "16 Smash 'n' Grab targets show in the Robberies map menu on our save: 10 jewelry stores and 6 pawn shops. Stores you've already robbed move to a Previously Hit list until they restock." },
  { q: "When can you rob jewelry stores in GTA 6?", a: "From Chapter 2. We had 16 Smash 'n' Grabs, jewelry stores included, on the map in Chapter 2. Guides that say Chapter 3 are describing Yasmani's jewelry jobs, which add more stores and the Snap Gun." },
  { q: "Which GTA 6 jewelry store pays the most?", a: "Kowalski and Skala, at $14,000–25,000 each with medium security. They're in the same mall. Peacock, All That Glitters, Marshal's and Plush come next at $9,000–20,000." },
  { q: "What's the easiest store to rob in GTA 6?", a: "Vice City Pawn and Ernesto's Pawn. Both have low security and a $4,500–12,000 take, the best of any low-security target." },
  { q: "Do GTA 6 jewelry store safe codes change?", a: "For free-roam smash and grabs, guides report the code isn't fixed: you get it by threatening the staff or from a note in the back room, and one source says it changes each visit. The safes in Yasmani's Chapter 3 jewelry jobs do have fixed codes (Richardson 6815, Donovan Banks 0104, Casa de Empeño 1680). So far none of the free-roam safes we've hit needed a code: Buck's has a lockbox that opens on the spot and All That Glitters has a breakable safe. We'll keep logging each one." },
  { q: "Should you smash the cases or crack the safe?", a: "On our runs the cops arrived before we could clear the cases, so the reliable money is the safe: get the code from the staff, take the cash and bank it at an ATM. Jewelry also has to go to a fence, and taxis won't pick you up near the crime." },
];
---
<Article
  title="GTA 6 Jewelry Store & Pawn Shop Locations: All 16 Smash and Grabs"
  h1="GTA 6 Smash and Grab Locations: Every Jewelry Store and Pawn Shop"
  description="All 16 GTA 6 smash and grab targets from the in-game map: security level and take value for every jewelry store and pawn shop, the best picks, and the safe-first method. Open from Chapter 2."
  published="2026-11-22"
  crumbs={[{ href: "/gta-6/", label: "GTA 6" }]}
  faq={faq}
>
  <div class="callout"><p><strong>Quick answer:</strong> there are <strong>16 Smash 'n' Grab targets</strong>, 10 jewelry stores and 6 pawn shops, and they're open from <strong>Chapter 2</strong>. The biggest are <strong>Kowalski and Skala ($14,000–25,000)</strong>, side by side in the same mall. The easiest good one is <strong>Vice City Pawn or Ernesto's Pawn</strong>: low security, $4,500–12,000. Those are the map's numbers: our first real run, Florence &amp; Co., paid about $2,250 because it has no safe. We're testing every store on stream.</p></div>

  <h2>What our runs taught us</h2>
  <ul>
    <li><strong>The map's take value is a ceiling, not a promise.</strong> Florence &amp; Co. lists $4,500–12,000; we walked out with about $2,250 after fencing.</li>
    <li><strong>Whether a store has a safe decides if it's worth it.</strong> Florence &amp; Co. has none, so it's case jewelry only. Buck's has a small lockbox in the back office ($578), and All That Glitters a breakable safe. Neither needed a code, so you don't have to get one from the staff. Check the <strong>Safe?</strong> column; we fill it in as we visit each store.</li>
    <li><strong>The cops are quick.</strong> 3 stars about 30 seconds after the first smashed case, so you won't clear every case.</li>
    <li><strong>Location matters as much as the take.</strong> All That Glitters had the best haul so far (about $5,500 between cash and jewelry), but it's in the Bayside outdoor mall and police spawn right outside the door. Pick stores with a car parked at the door and an open road out.</li>
    <li><strong>Send your partner to fence.</strong> While driving with your partner, open the partner menu and pick <strong>Fence loot</strong>. They take the bag to the fence and you keep going, so the fence drive stops eating your time.</li>
  </ul>
  <figure style="margin:20px 0"><img src="/img/gta-6/sg/partner-fence-loot.webp" alt="GTA 6 partner menu while driving with options Fence loot, Speed up and Pull over" width="909" height="720" loading="lazy" decoding="async" style="border-radius:8px;width:100%" /><figcaption><small>The partner menu in the car: Fence loot sends Jason or Lucia to sell the bag for you.</small></figcaption></figure>

  <h2>Best method: fill the bags, hand off, let your partner fence</h2>
  <ol>
    <li><strong>Bring your partner.</strong> Pick the store in the map's Robberies menu and choose <strong>Invite Lucia</strong> (or Jason).</li>
    <li><strong>Grab the fixed cash first.</strong> Threaten the clerk, empty the register, then go straight for the safe or lockbox. At Buck's it's in the back office behind a red Staff Only door you break open. That cash goes straight to your bank at an ATM and isn't cut by a fence.</li>
    <li><strong>Smash cases last.</strong> Smashing is what brings the cops fast (3 stars about 30 seconds in at Florence &amp; Co.), so do it once the safe is done.</li>
    <li><strong>Hand over your bag when it's full</strong> (Hand over bag) and keep smashing with the empty one.</li>
    <li><strong>Get in the car and pick Fence loot.</strong> Your partner takes the bags to the fence. Dunk paid us the full $1,760 he'd quoted, so letting your partner do it costs nothing and saves the drive.</li>
  </ol>
  <p><strong>Escaping:</strong> at the car you can <strong>Clear &amp; stow bag</strong> into the trunk, and the partner menu offers <strong>Distract law</strong>, which may buy time when police are right outside.</p>
  <p><small>Still to test: whether the partner's <strong>Split up</strong> option makes them loot cases at the same time as you, and how much Distract law helps.</small></p>

  <h2>Best picks</h2>
  <ul>
    <li><strong>Biggest take: Kowalski or Skala.</strong> $14,000–25,000, medium security. They're in the same mall, about 1.7 miles from Ambrosia Raceway, so the Derby and these stores make an easy Chapter 2 loop.</li>
    <li><strong>Sweet spot: Vice City Pawn or Ernesto's Pawn.</strong> Low security and $4,500–12,000, the most money you can get without medium security.</li>
    <li><strong>Mid tier: Peacock, All That Glitters, Marshal's, Plush.</strong> $9,000–20,000, medium security. Peacock, All That Glitters and Richardson sit close together downtown.</li>
    <li><strong>Skip: Buck's Jewelry & Pawn ($500–5,000) and Richardson ($2,000–7,000).</strong> Richardson is a "large" store but has one of the smallest takes.</li>
  </ul>

  <h2>All 16 locations</h2>
  <p>Sorted by take value. Distance is what the map menu showed from Ambrosia Raceway, so it tells you roughly how far out each store is.</p>
  <div class="table-scroll"><table>
    <thead><tr><th>Store</th><th>Type</th><th>Security</th><th>Safe?</th><th class="num">Map take value</th><th class="num">Our take</th><th class="num">From Ambrosia</th><th>Area</th></tr></thead>
    <tbody>{stores.map((s) => (
      <tr><td><a href={`#${s.slug}`}><strong>{s.name}</strong></a></td><td>{s.kind}</td><td><span class={`diff ${s.sec === "Low" ? "d1" : "d2"}`}>{s.sec}</span></td><td>{field[s.slug]?.hasSafe ?? "?"}</td><td class="num">{money(s.lo)}–{money(s.hi)}</td><td class="num">{field[s.slug]?.takeShort ?? (field[s.slug]?.takeN ? "~" + money(field[s.slug].takeN!) : "–")}</td><td class="num">{s.dist} mi</td><td>{s.area}</td></tr>
    ))}</tbody>
  </table></div>
  <p><small>No store showed High security on our save. Security and take values are from our in-game map; area names combine our map view with <a href="https://finalboss.io/gta-6-smash-n-grab-locations" rel="noopener">FinalBoss</a> and <a href="https://www.gta6activities.com/activities/jewelry-store-robbery" rel="noopener">GTA6Activities</a>.</small></p>

  <h2>Why only 16? Guides list about 35</h2>
  <p>Our Chapter 2 map menu showed 16 targets on Jason's side; Lucia's list later showed 21, adding stores like Crown Jewels and Dorado Pawn Shop. Location guides count about 35 jewelry stores and pawn shops across Leonida, including Akoya Jewelers, Blanc &amp; Giroux, Covgari, Donovan Banks &amp; Co., Rococo Rich, Casa de Empeño and Avery Pawn. Some are tied to Yasmani's Chapter 3 jewelry jobs, so more are likely to appear as the story moves on. We'll add each one with its in-game security and take when it shows up for us.</p>
  <p>Where guides disagree with our map, we trust the map: they list Richardson at $4,500–12,000 (our map: $2,000–7,000) and ICEGEM at $14,000–25,000 (ours: $5,000–10,000, after we'd already hit it once).</p>

  {shots.map((s) => <figure style="margin:20px 0"><img src={s.src} alt={s.alt} width="918" height="720" loading="lazy" decoding="async" style="border-radius:8px;width:100%" /><figcaption><small>{s.cap}</small></figcaption></figure>)}

  <h2>Store by store</h2>
  <p>Each card shows the store's spot on the in-game map, with the security and take value the game lists. The rows underneath fill in as we rob each one on stream: how many guards, how many cases, where the safe is, how long the cops take, and what we actually walked out with.</p>
  <div class="sg-grid">
    {stores.map((s) => (
      <article class="sg-card" id={s.slug}>
        <img src={`/img/gta-6/sg/${s.slug}.webp`} alt={`GTA 6 map showing ${s.name}, ${s.kind.toLowerCase()} store, ${s.sec.toLowerCase()} security, take value ${money(s.lo)} to ${money(s.hi)}`} width="918" height="720" loading="lazy" decoding="async" />
        <div class="sg-body">
          <h3>{s.name}</h3>
          <p class="sg-meta"><span class={`diff ${s.sec === "Low" ? "d1" : "d2"}`}>{s.sec} security</span> <strong class="sg-take">{money(s.lo)}–{money(s.hi)}</strong></p>
          <p class="sg-meta">{s.kind} · {s.area} · {s.dist} mi from Ambrosia Raceway</p>
          <dl>
            {rows.map(([k, label]) => <><dt>{label}</dt><dd>{field[s.slug]?.[k] ?? <span class="sg-todo">Not tested yet</span>}</dd></>)}
          </dl>
          {field[s.slug]?.notes && <p class="sg-note">{field[s.slug].notes}</p>}
          {field[s.slug]?.pics?.map((x) => <figure class="sg-pic"><img src={x.src} alt={x.alt} width="909" height="720" loading="lazy" decoding="async" /><figcaption><small>{x.cap}</small></figcaption></figure>)}
        </div>
      </article>
    ))}
  </div>

  <h2>How to rob them: safe first</h2>
  <ol>
    <li><strong>Pick the store from the map.</strong> Open the map, go to Robberies, then Smash 'n' Grabs. Each one shows its security and take value, and you can invite Lucia from there. Your partner carries a second bag when yours is full, and can take the loot to the fence for you.</li>
    <li><strong>Find the safe, usually in the back office.</strong> The ones we've hit needed no code: a lockbox that opens on the spot (Buck's) and a breakable safe (All That Glitters). If a safe does ask for a code, threaten the staff or look for a note in the back room. Security guards will shoot, and smashing a case brings the cops fast. On our runs there wasn't time to clear every case before they arrived. A sticky bomb also opens the safe, but guides say it destroys some of the cash.</li>
    <li><strong>Take the safe cash and leave.</strong> Grab cases on the way out only if the cops aren't there yet.</li>
    <li><strong>Bank the cash, send the jewelry.</strong> Cash goes straight into BuckMe at an ATM. Jewelry has to go to a fence (Dunk's Trailer in Chapter 2 pays a Low rate), and taxi fast travel won't work near the crime. Pick <strong>Fence loot</strong> in the partner menu and your partner makes the fence run for you. See <a href="/gta-6/buckme/">BuckMe limits</a>: checking caps at $15,000 until heists unlock and Family Savings is filled.</li>
  </ol>
  <p>Pawn shops also buy collectibles like cards, doubloons and meteorites, so you can sell those on the same trip.</p>

  <h2>Compare it with the Derby</h2>
  <p>A Kowalski or Skala safe-first run is likely worth more per trip than a <a href="/gta-6/demolition-derby/">figure-8 Derby win</a> ($3,150), but it comes with police. We're timing full loops on stream. Plug your own numbers into the <a href="/gta-6/make-money/">GTA 6 money per hour calculator</a> to compare.</p>
</Article>

<style>
  .sg-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 16px; margin: 16px 0; }
  .sg-card { background: var(--panel); border: 1px solid var(--line); border-radius: 14px; overflow: hidden; scroll-margin-top: 80px; }
  .sg-card img { display: block; width: 100%; height: auto; aspect-ratio: 918 / 720; object-fit: cover; }
  .sg-body { padding: 12px 14px 14px; }
  .sg-body h3 { margin: 0 0 6px; }
  .sg-meta { margin: 4px 0; font-size: .92rem; color: var(--muted); }
  .sg-take { color: var(--money); margin-left: 6px; }
  .sg-body dl { display: grid; grid-template-columns: auto 1fr; gap: 4px 12px; margin: 10px 0 0; font-size: .9rem; }
  .sg-body dt { color: var(--muted); }
  .sg-body dd { margin: 0; }
  .sg-todo { color: var(--muted); opacity: .7; font-style: italic; }
  .sg-note { font-size: .88rem; margin: 10px 0 0; }
  .sg-pic { margin: 10px 0 0; }
  .sg-pic img { border-radius: 8px; aspect-ratio: auto; }
</style>
