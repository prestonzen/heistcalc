---
import Article from "../../layouts/Article.astro";

// All values read off the in-game Robberies > Smash 'n' Grabs map menu on our stream (2026-11-22, Chapter 2).
// dist = miles shown in the menu from Ambrosia Raceway, where we opened it.
type Store = { slug: string; name: string; kind: string; sec: "Low" | "Medium"; lo: number; hi: number; dist: number; area: string };
const stores: Store[] = [
  { slug: "kowalski", name: "Kowalski", kind: "Large, high-end jewelry", sec: "Medium", lo: 14000, hi: 25000, dist: 1.73, area: "Waning Sands mall, next to Skala" },
  { slug: "skala", name: "Skala", kind: "Large, low-end jewelry", sec: "Medium", lo: 14000, hi: 25000, dist: 1.79, area: "Waning Sands mall, next to Kowalski" },
  { slug: "peacock", name: "Peacock", kind: "Small, low-end jewelry", sec: "Medium", lo: 9000, hi: 20000, dist: 3.3, area: "Vice City, by Panos Plaza" },
  { slug: "all-that-glitters", name: "All That Glitters", kind: "Small, low-end jewelry", sec: "Medium", lo: 9000, hi: 20000, dist: 3.35, area: "Vice City, by Panos Plaza" },
  { slug: "marshals", name: "Marshal's", kind: "Small, high-end jewelry", sec: "Medium", lo: 9000, hi: 20000, dist: 3.7, area: "Vice Beach" },
  { slug: "plush", name: "Plush", kind: "Small, high-end jewelry", sec: "Medium", lo: 9000, hi: 20000, dist: 3.84, area: "Tequesta" },
  { slug: "vice-city-pawn", name: "Vice City Pawn", kind: "Pawn shop", sec: "Low", lo: 4500, hi: 12000, dist: 2.65, area: "Vice City, near Panos Plaza" },
  { slug: "ernestos-pawn", name: "Ernesto's Pawn", kind: "Pawn shop", sec: "Low", lo: 4500, hi: 12000, dist: 4.35, area: "Vice City, near Peacock Estates" },
  { slug: "florence-co", name: "Florence & Co.", kind: "Pawn shop", sec: "Medium", lo: 4500, hi: 12000, dist: 0.17, area: "Ambrosia, next to the raceway" },
  { slug: "the-jewelry-place", name: "The Jewelry Place", kind: "Small, low-end jewelry", sec: "Low", lo: 1000, hi: 10000, dist: 2.52, area: "Vice-Dale" },
  { slug: "fast-cash", name: "Fast Cash", kind: "Pawn shop", sec: "Low", lo: 1000, hi: 10000, dist: 3.04, area: "Vice City" },
  { slug: "pawn-city", name: "Pawn City", kind: "Pawn shop", sec: "Low", lo: 1000, hi: 10000, dist: 3.47, area: "Vice City" },
  { slug: "sirens-chest", name: "The Siren's Chest", kind: "Small, low-end jewelry", sec: "Low", lo: 1000, hi: 10000, dist: 7.14, area: "Key Lento (guides); far out on the coast" },
  { slug: "icegem", name: "ICEGEM Diamonds & Watches", kind: "Large, low-end jewelry", sec: "Medium", lo: 5000, hi: 10000, dist: 3.4, area: "Downtown Vice City" },
  { slug: "richardson", name: "Richardson Jewelry & Diamonds", kind: "Large, low-end jewelry", sec: "Medium", lo: 2000, hi: 7000, dist: 3.35, area: "Vice City, by Panos Plaza" },
  { slug: "bucks-jewelry-pawn", name: "Buck's Jewelry & Pawn", kind: "Pawn shop", sec: "Low", lo: 500, hi: 5000, dist: 2.47, area: "Port Gellhorn" },
];
// Field notes, filled in as we hit each store on stream. Empty = not tested yet.
type Field = { hc?: "Easy" | "Medium" | "Hard"; hasSafe?: string; guards?: string; cases?: string; safe?: string; code?: string; cops?: string; take?: string; takeN?: number; takeShort?: string; notes?: string; pics?: { src: string; alt: string; cap: string }[] };
const field: Record<string, Field> = {
  "vice-city-pawn": {
    hc: "Easy",
    hasSafe: "Yes, breakable (no code)",
    guards: "None. One clerk behind a gun-counter cage, and a few vagrants in the alley outside.",
    cases: "Only a few small cases; they gave just $60 of jewelry.",
    safe: "In the dark back office past the storage room. You break it open (no code), and it gave $1,256.",
    code: "No code needed: you break it open.",
    cops: "Crime reported about 40 seconds after threatening the clerk, just as the safe opened. 2 stars.",
    take: "About $1,750: $200 from the register, $1,256 from the safe, $60 of jewelry and some loose cash. The storage room also had a free KZ-59 assault rifle.",
    takeN: 1750,
    notes: "Back-alley store in Vice City with an easy getaway. Done solo at the start of Chapter 3. Tested 2026-11-22 on stream.",
    pics: [
      { src: "/img/gta-6/sg/vice-city-pawn-front.webp", alt: "Yellow Vice City Pawn storefront in a back alley in GTA 6", cap: "The entrance is in a quiet back alley, so the getaway is easy." },
      { src: "/img/gta-6/sg/vice-city-pawn-counter.webp", alt: "Inside Vice City Pawn in GTA 6, a small jewelry case and guitars on the wall", cap: "Only a few small cases. The money is in the back." },
      { src: "/img/gta-6/sg/vice-city-pawn-safe-cash.webp", alt: "Jason in the dark back office of Vice City Pawn with +$1,256 cash on screen, GTA 6", cap: "The back-office safe paid $1,256, then the crime was reported." },
    ],
  },
  "all-that-glitters": {
    hc: "Hard",
    hasSafe: "Yes, breakable (no code)",
    guards: "One armed security guard by the front door, and another came out of the back office.",
    cases: "About 10 cases around the counter plus the wall displays. A fast smash run filled a bag with $3,240 of jewelry.",
    safe: "A breakable floor safe in the back office, through the white door behind the counter.",
    code: "No code needed: you break it open.",
    cops: "Bad: the store is in the Bayside outdoor mall and police spawn right outside the door, across the walkway. 3 stars, and we were Wasted on the way to the car.",
    take: "About $5,500 on us before the cops: $2,255 cash from the register and safe, plus $3,240 of jewelry. Getting Wasted costs your pocket cash, so get out fast or skip this one.",
    takeShort: "~$5,500, lost",
    notes: "Tested 2026-11-22 on stream (we meant to hit Ernesto's Pawn). The partner menu here offered Distract law, worth trying against the cops out front.",
    pics: [
      { src: "/img/gta-6/sg/all-that-glitters-guard.webp", alt: "Armed security guard standing by the front door inside All That Glitters jewelry store in GTA 6", cap: "One armed guard stands by the door, so deal with him first." },
      { src: "/img/gta-6/sg/all-that-glitters-cases.webp", alt: "Jason filling a bag from the display cases in All That Glitters, GTA 6, with $3,240 of jewelry on screen", cap: "A quick smash run: $3,240 of jewelry in the bag plus $2,437 cash on Jason." },
      { src: "/img/gta-6/sg/all-that-glitters-safe.webp", alt: "Jason at the safe in the back office of All That Glitters in GTA 6", cap: "The safe is in the back office, through the white door behind the counter." },
      { src: "/img/gta-6/sg/all-that-glitters-cops-outside.webp", alt: "Police right outside All That Glitters in the Bayside outdoor mall in GTA 6 as Jason runs to the car", cap: "The problem: police spawn right outside in the mall walkway." },
    ],
  },
  "bucks-jewelry-pawn": {
    hc: "Easy",
    hasSafe: "Yes, lockbox (no code)",
    guards: "None seen. A clerk at the counter, plus a worker in the back office.",
    cases: "A few cases along the counter, plus the register (about $50).",
    safe: "Small cash lockbox on a desk in the back office, behind a red Staff Only door you break open. It gave $578. The storage room next to it also had a Gold collectible card.",
    code: "No code needed: the lockbox opens on the spot.",
    cops: "Crime reported about 40 seconds after we threatened the clerk.",
    take: "About $700 in cash ($578 lockbox, the rest from the register and a case) plus a Gold collectible card. Inside the map's $500–5,000 range, but low.",
    takeN: 700,
    notes: "Port Gellhorn. After the robbery the map shows it as Currently closed. Tested 2026-11-22 on stream.",
    pics: [
      { src: "/img/gta-6/sg/bucks-staff-only-door.webp", alt: "Red Staff Only door with a Break open prompt inside Buck's Jewelry & Pawn in GTA 6", cap: "Break open the red Staff Only door behind the counter to reach the back office." },
      { src: "/img/gta-6/sg/bucks-lockbox.webp", alt: "Small black cash lockbox on a desk in the back office of Buck's Jewelry & Pawn, GTA 6", cap: "The safe: a small cash lockbox on the office desk. $578 for us." },
    ],
  },
  "florence-co": {
    hc: "Easy",
    hasSafe: "No",
    guards: "No armed guard inside on our visit. Staff behind the main counter and at the Jewelry Repairs desk.",
    cases: "About 10 glass cases around a U-shaped counter, plus the register.",
    safe: "None. No staff back office either: just a security panel on the staff side of the counter.",
    code: "No safe here.",
    cops: "3 stars about 30 seconds after the first smashed case.",
    take: "About $2,250: $1,760 for the jewelry (our partner fenced it at Dunk's Trailer and the full $1,760 came through) plus about $500 from the register. Half the $4,500 minimum the map lists.",
    takeN: 2250,
    notes: "Lucia took the second bag (Hand over bag), and we sent her to fence it with Fence loot. Tested 2026-11-22 on stream.",
    pics: [
      { src: "/img/gta-6/sg/florence-co-cases.webp", alt: "Smashing the glass display cases inside Florence & Co. in GTA 6, with jewelry values popping up", cap: "Inside: about 10 cases around the counter. Each smash adds $30–190 of jewelry." },
      { src: "/img/gta-6/sg/florence-co-fence-dunk.webp", alt: "GTA 6 map card for Dunk's Trailer showing jewelry worth $1,760 at a low rate", cap: "Dunk's Trailer valued the jewelry at $1,760, at his Low rate." },
    ],
  },
  icegem: { notes: "Robbed once on stream before this list; it now shows under Previously Hit with a lower take ($5,000–10,000)." },
  richardson: { notes: "The map card lists a Features icon that no other store shows. We'll check what it is on our visit." },
  "the-jewelry-place": { notes: "Scouted on stream 2026-11-23, not robbed yet: low security, 3 cases, one staff member and a room in the back. It's a hard spot to drive away from." },
};
const rows: [keyof Field, string][] = [["hasSafe", "Has a safe?"], ["guards", "Guards"], ["cases", "Display cases"], ["safe", "Safe"], ["code", "Safe code"], ["cops", "Cops arrive"], ["take", "Our take"]];
const money = (n: number) => "$" + n.toLocaleString("en-US");
const kk = (n: number) => "$" + (n >= 1000 ? +(n / 1000).toFixed(1) + "k" : n);
const hcOf = (s: Store) => field[s.slug]?.hc ?? null;
const hcGuess = (s: Store) => (s.sec === "Low" ? "Easy" : "Medium");
const dcls = { Easy: "d1", Medium: "d2", Hard: "d3" } as const;
const tested = stores.filter((s) => hcOf(s));
const untested = stores.filter((s) => !hcOf(s));
// Stores other guides list that haven't shown up in our map menu yet (reported, not verified by us).
const more = [
  ["Akoya Jewelers", "Vice City", "$14,000–25,000"], ["Blanc & Giroux", "Vice City", "$14,000–25,000 (one guide: up to $35,000)"],
  ["Covgari", "Vice City", "$14,000–25,000 (one guide: up to $35,000)"], ["Royal Jewelry", "Vice City", "$14,000–25,000"],
  ["Donovan Banks & Co.", "Vice City", "$14,000–25,000; safe code 0104 in Yasmani's job (confirmed on our stream: the amethyst necklace is in that safe)"], ["Legendary Custom Jewelry", "Vice Beach", "$14,000–25,000"],
  ["Rococo Rich", "Vice Beach", "$14,000–25,000"], ["Victoria Lee Jeweler", "Capri, Mariana County", "$9,000–20,000. We scouted it: 1 guard, an ATM, and an alarm"],
  ["Brilliant Cuts", "Belville, Leonard County", "$9,000–20,000"], ["Casa de Empeño", "Vice Beach", "$4,500–12,000; safe code 1680 in Yasmani's job"],
  ["Hamlet Pawn", "Hamlet", "$4,500–12,000; buys the Leroy Rook card for $6,000"], ["White Sands Jewelry Pawn", "Vice City", "$4,500–12,000"],
  ["Dorado Pawn Shop", "Vice City", "$4,500–12,000"], ["Timeless Peculiars", "Watson Bay, Mariana County", "$4,500–12,000"],
  ["Joyeria Empeños", "Vice City", "$4,500–12,000"], ["Pawn Stash", "Vice City", "$4,500–12,000"],
  ["Crown Jewels", "Vice-Dale", "$1,000–10,000. We scouted it: small low-end store, Low security, 7 cases, no guard (just one staff member), but a bad spot for a getaway"], ["Avery Pawn", "Port Gellhorn", "$1,000–10,000"],
  ["Down Town Pawn", "Downtown", "$1,000–10,000"], ["Martez Empeños", "Vice City", "$1,000–10,000"],
];
const faq = [
  { q: "How many jewelry stores can you rob in GTA 6?", a: "16 Smash 'n' Grab targets show in the Robberies map menu on our save: 10 jewelry stores and 6 pawn shops. Stores you've already robbed move to a Previously Hit list until they restock." },
  { q: "When can you rob jewelry stores in GTA 6?", a: "From Chapter 2. We had 16 Smash 'n' Grabs, jewelry stores included, on the map in Chapter 2. Guides that say Chapter 3 are describing Yasmani's jewelry jobs, which add more stores and the Snap Gun." },
  { q: "Which GTA 6 jewelry store pays the most?", a: "Kowalski and Skala, at $14,000–25,000 each with medium security. They're in the same mall. Peacock, All That Glitters, Marshal's and Plush come next at $9,000–20,000." },
  { q: "What's the easiest store to rob in GTA 6?", a: "Of the ones we've tested, Vice City Pawn: no guards, a breakable back-office safe that paid $1,256 with no code, and a quiet back-alley getaway. Buck's Jewelry & Pawn is just as easy but pays less." },
  { q: "Do GTA 6 jewelry store safe codes change?", a: "For free-roam smash and grabs, guides report the code isn't fixed: you get it by threatening the staff or from a note in the back room, and one source says it changes each visit. The safes in Yasmani's Chapter 3 jewelry jobs do have fixed codes (Richardson 6815, Donovan Banks 0104, Casa de Empeño 1680); we confirmed Donovan Banks' 0104 on stream. So far none of the free-roam safes we've hit needed a code: Buck's has a lockbox that opens on the spot and All That Glitters has a breakable safe. We'll keep logging each one." },
  { q: "Should you smash the cases or crack the safe?", a: "Safe first. On our runs the cops arrived before we could clear every case, and none of the safes we hit needed a code. Take the safe cash, smash cases until the cops show, then send your partner to fence the jewelry." },
];
---
<Article
  title="GTA 6 Jewelry Store & Pawn Shop Locations: Every Smash and Grab, Rated"
  h1="GTA 6 Smash and Grab Locations: Every Jewelry Store and Pawn Shop"
  description="Every GTA 6 smash and grab target with the in-game security and take value, our own Easy/Medium/Hard rating, which stores have a safe, what we actually got, and the best method. Open from Chapter 2."
  published="2026-11-22"
  updated="2026-11-23"
  crumbs={[{ href: "/gta-6/", label: "GTA 6" }]}
  faq={faq}
  image={{ src: "/img/gta-6/smash-grab-kowalski.webp", alt: "GTA 6 Robberies map menu showing Kowalski jewelry store, medium security, take value $14,000 to $25,000" }}
  sources={[
    { href: "https://finalboss.io/gta-6-smash-n-grab-locations", label: "FinalBoss: smash 'n' grab locations" },
    { href: "https://www.gta6activities.com/activities/jewelry-store-robbery", label: "GTA6Activities: jewelry store robbery" },
    { href: "https://games.gg/grand-theft-auto-vi/guides/grand-theft-auto-6-jewelry-stores-guide-locations-codes/", label: "games.gg: jewelry stores, locations and codes" },
    { href: "https://outputlag.com/guides/gta-6-jewelry-bank-robberies/", label: "Output Lag: jewelry and bank robberies" },
  ]}
>
  <div class="callout"><p><strong>Quick answer:</strong> smash and grabs open in <strong>Chapter 2</strong>. Our map showed 16 targets (guides list about 35 across Leonida). The map's take value is a ceiling: we got a quarter to half of it. <strong>The safe is what pays</strong>, and none we've hit needed a code. Easiest so far: <strong>Vice City Pawn</strong> (no guards, $1,256 safe, quiet alley). Biggest listed take: <strong>Kowalski and Skala</strong> ($14,000–25,000, same mall).</p></div>

  <h2>HeistCalc difficulty</h2>
  <p>The game only says Low or Medium security. We rate each store by what it's actually like to rob:</p>
  <ul class="sg-key">
    <li><span class="diff d1">Easy</span> No guards. The safe needs no code, and the alarm is a security panel you can deal with.</li>
    <li><span class="diff d2">Medium</span> One armed guard you'll have to take down.</li>
    <li><span class="diff d3">Hard</span> Several guards, or the cops spawn right outside.</li>
  </ul>
  <p><small>Stores we haven't robbed yet show a guess with a question mark, based on the game's security level.</small></p>

  <h2>Every location</h2>
  <div class="table-scroll"><table class="sg-table">
    <thead><tr><th>Store</th><th>Difficulty</th><th>Safe?</th><th class="num">Map take</th><th class="num">Our take</th></tr></thead>
    <tbody>{stores.map((s) => (
      <tr>
        <td><a href={`#${s.slug}`}><strong>{s.name}</strong></a><br /><small>{s.kind} · {s.area}</small></td>
        <td>{hcOf(s) ? <span class={`diff ${dcls[hcOf(s)!]}`}>{hcOf(s)}</span> : <span class="sg-guess">{hcGuess(s)}?</span>}</td>
        <td>{field[s.slug]?.hasSafe?.replace(/ \(no code\)/, "") ?? <span class="sg-guess">?</span>}</td>
        <td class="num"><span class="mf">{money(s.lo)}–{money(s.hi)}</span><span class="ms">{kk(s.lo)}–{kk(s.hi).slice(1)}</span></td>
        <td class="num">{field[s.slug]?.takeShort ?? (field[s.slug]?.takeN ? "~" + money(field[s.slug].takeN!) : "–")}</td>
      </tr>
    ))}</tbody>
  </table></div>

  <h2>Best method: one character carries both bags, then the partner drives and fences</h2>
  <ol>
    <li><strong>Bring your partner, and the Snap Gun once you have it.</strong> Pick the store in the map's Robberies menu and choose <strong>Invite Lucia</strong> (or Jason). With the Snap Gun (from Yasmani's Chapter 3 jobs) and a partner, there's a chance the cops never get called, and that's what makes smash and grabs worth it.</li>
    <li><strong>Grab the fixed cash first.</strong> Threaten the clerk, empty the register, then go straight for the safe or lockbox, usually in a back office behind a door you break open. That cash goes straight to your bank at an ATM and isn't cut by a fence.</li>
    <li><strong>Don't shoot the staff.</strong> Threatening is enough, and killing clerks drags your <a href="/gta-6/criminal-profile/">Criminal Profile</a> toward Psycho.</li>
    <li><strong>Smash cases last.</strong> Smashing brings the cops fast (3 stars about 30 seconds in at Florence &amp; Co.).</li>
    <li><strong>Put both bags on one character.</strong> When your bag is full, take the second bag and keep smashing.</li>
    <li><strong>Swap to the character with empty hands.</strong></li>
    <li><strong>Send the bag carrier to drive.</strong> Get in the car and tell the character with the bags to drive.</li>
    <li><strong>Tell them to Fence loot</strong> from the partner menu. Dunk paid us the full $1,760 he'd quoted.</li>
  </ol>
  <p><strong>No car? Your partner still fences.</strong> Fence loot is in the partner menu on foot too. They'll call a taxi or take a car nearby and go sell the bags on their own.</p>
  <div class="sg-pics" style="max-width:720px">
    <figure><img src="/img/gta-6/sg/partner-fence-loot.webp" alt="GTA 6 partner menu while driving with options Fence loot, Speed up and Pull over" width="909" height="720" loading="lazy" decoding="async" /><figcaption><small>In the car: Fence loot sends your partner to sell the bags.</small></figcaption></figure>
    <figure><img src="/img/gta-6/sg/partner-fence-on-foot.webp" alt="GTA 6 partner menu on foot outside a jewelry store with options You drive and Fence loot for Lucia" width="909" height="720" loading="lazy" decoding="async" /><figcaption><small>On foot outside the store: Fence loot works without a car.</small></figcaption></figure>
  </div>
  <p><strong>Also good to know:</strong> at the car you can <strong>Clear &amp; stow bag</strong> into the trunk, the partner menu has <strong>Distract law</strong> for cops right outside, and pawn shops buy collectibles (cards, doubloons, meteorites) on the same trip. A RydeMe taxi did pick us up right after a robbery with the cops still searching, but you can't skip the ride after a crime (and the driver told us to fake a heart attack if we got pulled over).</p>

  <h2>Stores we've robbed</h2>
  {tested.map((s) => (
    <article class="sg-card sg-full" id={s.slug}>
      <div class="sg-head">
        <img src={`/img/gta-6/sg/${s.slug}.webp`} alt={`GTA 6 map showing ${s.name}`} width="918" height="720" loading="lazy" decoding="async" />
        <div>
          <h3>{s.name}</h3>
          <p class="sg-meta"><span class={`diff ${dcls[hcOf(s)!]}`}>{hcOf(s)}</span> <span class="sg-chip">Game: {s.sec} security</span> <strong class="sg-take">{money(s.lo)}–{money(s.hi)}</strong></p>
          <p class="sg-meta">{s.kind} · {s.area}</p>
          <dl>
            {rows.map(([k, label]) => field[s.slug]?.[k] && <><dt>{label}</dt><dd>{field[s.slug][k]}</dd></>)}
          </dl>
          {field[s.slug]?.notes && <p class="sg-note">{field[s.slug].notes}</p>}
        </div>
      </div>
      {field[s.slug]?.pics && <div class="sg-pics">{field[s.slug].pics!.map((x) => <figure><img src={x.src} alt={x.alt} width="909" height="720" loading="lazy" decoding="async" /><figcaption><small>{x.cap}</small></figcaption></figure>)}</div>}
    </article>
  ))}

  <h2>Not robbed yet</h2>
  <p>Their spot on the in-game map, with the security and take the game lists. Each one moves up when we hit it on stream.</p>
  <div class="sg-grid">
    {untested.map((s) => (
      <article class="sg-card" id={s.slug}>
        <img src={`/img/gta-6/sg/${s.slug}.webp`} alt={`GTA 6 map showing ${s.name}, ${s.kind.toLowerCase()}, ${s.sec.toLowerCase()} security, take value ${money(s.lo)} to ${money(s.hi)}`} width="918" height="720" loading="lazy" decoding="async" />
        <div class="sg-body">
          <h3>{s.name}</h3>
          <p class="sg-meta"><span class="sg-guess">{hcGuess(s)}?</span> <span class="sg-chip">Game: {s.sec}</span> <strong class="sg-take">{money(s.lo)}–{money(s.hi)}</strong></p>
          <p class="sg-meta">{s.kind} · {s.area}</p>
          {field[s.slug]?.notes && <p class="sg-note">{field[s.slug].notes}</p>}
        </div>
      </article>
    ))}
  </div>

  <h2>More stores other guides list</h2>
  <p>Location guides count about 35 jewelry stores and pawn shops in Leonida. These haven't shown up in our Chapter 2 map menu yet (Lucia's list did add Crown Jewels and Dorado Pawn Shop), so the take bands below are what guides report, not our numbers. Several are tied to Yasmani's Chapter 3 jewelry jobs.</p>
  <div class="table-scroll"><table class="sg-table">
    <thead><tr><th>Store</th><th>Area</th><th>Reported take</th></tr></thead>
    <tbody>{more.map(([n, a, t]) => <tr><td><strong>{n}</strong></td><td>{a}</td><td>{t}</td></tr>)}</tbody>
  </table></div>
  <p><small>Where guides disagree with our map, we trust the map: they list Richardson at $4,500–12,000 (ours: $2,000–7,000) and ICEGEM at $14,000–25,000 (ours: $5,000–10,000, after we'd already hit it once). Guides also report free-roam safe codes change between visits; the Yasmani job codes are fixed.</small></p>

  <h2>Compare it with the Derby</h2>
  <p>A good safe store pays $1,000–2,500 in cash for a few minutes and some police heat. A <a href="/gta-6/demolition-derby/">figure-8 Derby win with your partner</a> pays up to $6,300 in about 2 minutes with no cops, so the Derby is still the better money; robberies are for variety. Compare everything in the <a href="/gta-6/make-money/">money per hour calculator</a>.</p>
</Article>

<style>
  .sg-key { list-style: none; padding: 0; }
  .sg-key li { margin: 6px 0; }
  .sg-key .diff { min-width: 64px; text-align: center; margin-right: 8px; }
