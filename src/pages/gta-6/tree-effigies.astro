  { src: "/img/gta-6/tree-effigy-3-seaplane.webp", alt: "Seaplane landed in the shallow water of Gullet Marsh near the tree effigy", cap: "The fastest way in: land a seaplane on the marsh water. The effigy is a short walk away in the trees." },
