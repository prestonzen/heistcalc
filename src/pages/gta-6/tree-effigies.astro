const faq = [
  { q: "Where are the tree effigies in GTA 6?", a: "All three are inside the pink search circle Kirk marks on your map, in the swamps of Gullet Marsh between Watson Bay and Hamlet. One is on the north edge of the circle, just south of the Pelican River, in a grove of mangroves. You can find them in any order." },
