---
import Base from "../layouts/Base.astro";
import Ad from "../components/Ad.astro";
import { SITE } from "../config";

const gta6 = [
  { href: "/gta-6/demolition-derby/", tag: "Found on our stream", title: "Chapter 2 Fast Money Method", text: "Our Demolition Derby cheese: park on the figure-8 ramp and win $3,150 in as little as 1:18. About $50,000 an hour." },
  { href: "/gta-6/buckme/", tag: "Calculator", title: "BuckMe & Family Savings Calculator", text: "What the Chapter 1 wipe takes, and when the checking and savings limits jump to $100,000 in Chapter 2." },
  { href: "/gta-6/mr-mangrove/", tag: "Walkthrough", title: "Skunk Man Quest: Find Mr. Mangrove", text: "Kirk's last Skunk Ape quest, the frog trip and the real $5,000 payout, with screenshots from our playthrough." },
  { href: "/gta-6/safe-codes/", tag: "Codes", title: "GTA 6 Safe Codes", text: "Every known safe code for stores, jewelry shops and hidden stashes." },
  { href: "/gta-6/cheat-codes/", tag: "Codes", title: "GTA 6 Cheat Codes", text: "All verified cheats for PS5 and Xbox, and which ones block saving." },
  { href: "/gta-6/", tag: "Hub", title: "Every GTA 6 Guide", text: "Missions, fastest cars, fast travel, collectibles, trophies and the Leonida map." },
];
const calculators = [
  { href: "/cayo-perico-calculator/", tag: "GTA Online", title: "Cayo Perico Heist Calculator", text: "Pick your primary target, fill your bags with the best secondary loot, and see every player's cut after Pavel and fencing fees." },
  { href: "/diamond-casino-heist-calculator/", tag: "Calculator", title: "Diamond Casino Heist Calculator", text: "Target, buyer, support crew and cuts. Find out what the Diamond Casino Heist actually pays out." },
  { href: "/timers/", tag: "New", title: "Cooldown Timers & Hard Mode Alarm", text: "Tap when your Cayo finale ends and get an alert (in your browser or Discord) when Pavel's ready, before the Hard Mode window closes." },
  { href: "/weekly-checklist/", tag: "New", title: "Weekly Bonus Checklist", text: "Track this week's first-run heist bonuses. Resets itself every Thursday at the weekly reset." },
  { href: "/gta-online-weekly-update/", tag: "Weekly", title: "This Week in GTA Online", text: "Every money bonus, heist note, discount and vehicle for the current week, updated after each Thursday reset." },
  { href: "/heist-cut-calculator/", tag: "Calculator", title: "Heist Cut Calculator", text: "Split any heist take between up to four players. Works for every GTA game, including GTA 6 on day one." },
  { href: "/gta-online-heist-payouts/", tag: "Data", title: "Every GTA Online Heist Payout", text: "Fleeca to Cayo Perico and the Doomsday Heist, side by side by difficulty, with setup costs and bonuses." },
];
const guides = [
  { href: "/guides/best-heists-gta-online/", title: "Best heists in GTA Online (2026), ranked after the payout changes" },
  { href: "/guides/cayo-perico-solo-guide/", title: "Cayo Perico solo guide: max payout every run" },
  { href: "/gta-5-story-mode-heists/", title: "GTA 5 story mode heists: best approach and crew for max take" },
  { href: "/gta-6/heists/", title: "Heists in GTA 6: everything confirmed so far" },
  { href: "/gta-6/preload/", title: "How to preload GTA 6 on PS5 and Xbox, with a download time calculator" },
  { href: "/gta-6/editions/", title: "GTA 6 Standard vs Ultimate Edition: which to buy" },
];
const faq = [
  { q: "Is HeistCalc free?", a: "Yes. Every calculator is free, runs in your browser, and needs no account." },
  { q: "Are the payout values up to date?", a: "Each calculator lists the date its values were last checked and links to its sources. Rockstar changes payouts in updates, so we re-check after every major patch." },
  { q: "What's the best money in GTA 6 right now?", a: "It depends on your chapter. In Chapter 2 our Demolition Derby cheese (the Chapter 2 Fast Money Method) pays about $50,000 an hour. Later, bank vaults pay far more. The GTA 6 money per hour calculator ranks every method for the chapters you've unlocked." },
  { q: "Are the GTA 6 numbers tested?", a: "Where it says 'checked on our stream', yes: we play GTA 6 live every day as prestonzen. Other figures are the middle of what guides report and are labelled that way." },
];
const schema = [{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
}];
---
<Base title={SITE.name} description={SITE.description} schema={schema}>
  <section class="hero vice">
    <span class="tag">GTA 6 · Leonida</span>
    <h1>Make more money in Leonida.</h1>
    <p>Free GTA 6 money calculators and guides, tested live on stream. Find the best money per hour for the chapter you're on.</p>
  </section>

  <a class="feature" href="/gta-6/make-money/">
    <span class="tag gold">Main calculator</span>
    <h2>GTA 6 Money Per Hour Calculator</h2>
    <p>Every money method ranked for the chapters you've unlocked: Derby, Moses cars, robberies, Randy's supercars and bank vaults. Plug in your own run times and build a loop.</p>
    <span class="feature-cta">Open the calculator →</span>
  </a>

  <h2>GTA 6 guides and tools</h2>
  <div class="cards">
    {gta6.map((c) => (
      <a class="card" href={c.href}><span class={c.tag === "Found on our stream" ? "tag gold" : "tag"}>{c.tag}</span><h3>{c.title}</h3><p>{c.text}</p></a>
    ))}
  </div>

  <p class="stream-cta">Watch the tests live: <a href="https://www.youtube.com/@PrestonZen" rel="me noopener">YouTube</a> · <a href="https://www.tiktok.com/@prestonzen" rel="me noopener">TikTok</a> · GTA 6 every day as <strong>prestonzen</strong>.</p>

  <h2>GTA Online heist calculators</h2>
  <div class="cards">
    {calculators.map((c) => (
      <a class="card" href={c.href}><span class={c.tag === "Most popular" || c.tag === "New" ? "tag gold" : "tag"}>{c.tag}</span><h3>{c.title}</h3><p>{c.text}</p></a>
    ))}
  </div>

  <Ad />

  <section>
    <h2>Guides</h2>
    <ul>{guides.map((g) => <li><a href={g.href}>{g.title}</a></li>)}</ul>
  </section>

  <section class="faq">
    <h2>FAQ</h2>
    {faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
  </section>
</Base>
